worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;               # warn/error lines quote the request line, which carries the path key
events { worker_connections 256; }
http {
  access_log off;                         # URIs carry the path key
  client_body_temp_path /tmp/body; proxy_temp_path /tmp/proxy; fastcgi_temp_path /tmp/f; uwsgi_temp_path /tmp/u; scgi_temp_path /tmp/s;
  resolver __RESOLVER__ valid=60s ipv6=off;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 8080;
    client_max_body_size 100m;
    large_client_header_buffers 4 64k;      # SAP bearer tokens are JWTs larger than the 8k default
    proxy_buffer_size 64k;                   # room for large upstream response headers (buffering stays off)
    proxy_buffers 4 64k; proxy_busy_buffers_size 128k;
    proxy_http_version 1.1;
    proxy_buffering off; proxy_request_buffering off;
    proxy_read_timeout 600s; proxy_send_timeout 600s;
    proxy_ssl_server_name on; proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt; proxy_ssl_verify_depth 3;
    location = /__KEY__/healthz { return 200 "ok\n"; }
    location /__KEY__/api/ {
      set $up "__SAP_API_HOST__";
      rewrite ^/__KEY__/api/(.*)$ /$1 break;
      proxy_set_header Host $up;
      proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade;
      proxy_pass https://$up;
    }
    location /__KEY__/auth/ {
      set $up "__SAP_AUTH_HOST__";
      rewrite ^/__KEY__/auth/(.*)$ /$1 break;
      proxy_set_header Host $up;
      proxy_pass https://$up;
    }
    location / { return 404; }
  }
}
