# SAP LLM Gateway OAuth2 Authentication - Docker Integration
# =================================================================
# This configuration integrates oauth2-proxy + Dex authentication
# into the main SAP LLM Gateway Docker deployment

# =================================================================
# NGINX CONFIGURATION
# =================================================================
NGINX_HTTP_PORT=8080
NGINX_DOMAIN=localhost

# =================================================================
# DATABASE CONFIGURATION (Shared PostgreSQL)
# =================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sap_llm_gateway
POSTGRES_USER=admin_user
POSTGRES_PASSWORD=admin_password

# =================================================================
# IDENTITY PROVIDER CONFIGURATION
# =================================================================
# Identity provider selection: local, github, ldap, okta
IDENTITY_PROVIDER=okta

# =================================================================
# GROUP MAPPING CONFIGURATION
# =================================================================
# Map external groups/users to internal application roles
# Format: JSON object with "external_group": "internal_role" mappings

# Role mapping for admin service
# Maps Okta groups to application roles: {"okta-group-name":"role"}
# Available roles: admin, user
# This will be populated automatically by setup script based on your input
ROLE_MAPPING={}

# =================================================================
# OAUTH2-PROXY CONFIGURATION
# =================================================================
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_CLIENT_ID=oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=__OAUTH2_PROXY_CLIENT_SECRET__
OAUTH2_PROXY_COOKIE_SECRET=__OAUTH2_PROXY_COOKIE_SECRET__

# Basic settings
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_COOKIE_SECURE=false
# Cookie path for all routes (domain auto-detected from request)
OAUTH2_PROXY_COOKIE_PATH=/

# Whitelist domains for redirect validation
OAUTH2_PROXY_WHITELIST_DOMAINS=BASE_URL,localhost:8080,localhost

# Redirect URL (nginx routing)
OAUTH2_PROXY_REDIRECT_URL=BASE_URL/auth/callback

# OIDC configuration (Dex integration)
OAUTH2_PROXY_OIDC_ISSUER_URL=BASE_URL/dex
OAUTH2_PROXY_OIDC_GROUPS_CLAIM=groups
OAUTH2_PROXY_OIDC_EMAIL_CLAIM=email
OAUTH2_PROXY_SCOPE=openid email profile groups

# Debugging (set to info/warn for production)
OAUTH2_PROXY_LOGGING_LEVEL=debug
OAUTH2_PROXY_REQUEST_LOGGING=true

# Advanced OIDC settings - Required for proper Dex integration
# Note: oauth2-proxy talks to Dex directly via docker network for token exchange
OAUTH2_PROXY_SKIP_OIDC_DISCOVERY=true
OAUTH2_PROXY_LOGIN_URL=BASE_URL/dex/auth
OAUTH2_PROXY_REDEEM_URL=http://dex:5556/dex/token
OAUTH2_PROXY_OIDC_JWKS_URL=http://dex:5556/dex/keys
OAUTH2_PROXY_PROFILE_URL=http://dex:5556/dex/userinfo
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=true
OAUTH2_PROXY_PASS_USER_HEADERS=true

# Configure groups forwarding - CRITICAL for group-based authorization
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=true
OAUTH2_PROXY_PASS_BASIC_AUTH=false

# Enable groups in auth headers - this is key for admin role assignment
OAUTH2_PROXY_OIDC_GROUPS_CLAIM=groups
OAUTH2_PROXY_SET_AUTH_REQUEST_GROUPS=true
OAUTH2_PROXY_PASS_USER_GROUPS=true

# Additional oauth2-proxy settings
OAUTH2_PROXY_INSECURE_OIDC_SKIP_ISSUER_VERIFICATION=false
OAUTH2_PROXY_OIDC_EXTRA_AUDIENCES=oauth2-proxy

# =================================================================
# VALKEY CONFIGURATION
# =================================================================
VALKEY_URL=redis://valkey:6379

# =================================================================
# APPLICATION CONFIGURATION
# =================================================================
NODE_ENV=production
PORT_ADMIN=4004
PORT_GATEWAY=3000

# =================================================================
# FLEXIBLE DEPLOYMENT CONFIGURATION
# =================================================================
# Base URL for the application (used for issuer and redirect URLs)
# Development: http://localhost:8080
# Production: https://yourdomain.com
BASE_URL=http://localhost:8080

# JWT Configuration
JWT_ISSUER=${BASE_URL}/dex
JWT_AUDIENCE=oauth2-proxy

# Internal service endpoints
DEX_INTERNAL_HOST=dex
DEX_INTERNAL_PORT=5556
ADMIN_INTERNAL_HOST=admin
ADMIN_INTERNAL_PORT=4004
GATEWAY_INTERNAL_HOST=gateway
GATEWAY_INTERNAL_PORT=3000

# Logout redirect URL (set by setup script)
LOGOUT_REDIRECT_URL=__LOGOUT_REDIRECT_URL__
