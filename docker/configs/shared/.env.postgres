# PostgreSQL Configuration for Docker/Production Deployment
# CAP Database Configuration using dot notation (supported in .env files)
cds.requires.db.kind=postgres
cds.requires.db.impl=@cap-js/postgres
cds.requires.db.credentials.host=postgres
cds.requires.db.credentials.port=5432
cds.requires.db.credentials.user=admin_user
cds.requires.db.credentials.password=admin_password
cds.requires.db.credentials.database=sap_llm_gateway
cds.requires.db.schema_evolution=auto
cds.sql.dialect=postgres

# PostgreSQL Connection Pool Settings
cds.requires.db.pool.min=1
cds.requires.db.pool.max=10
cds.requires.db.pool.acquireTimeoutMillis=30000
cds.requires.db.pool.createTimeoutMillis=30000
cds.requires.db.pool.destroyTimeoutMillis=5000
cds.requires.db.pool.idleTimeoutMillis=30000
cds.requires.db.pool.reapIntervalMillis=1000

# Privileged file_search migration DSN. Plain env var, not a CAP dotted key —
# services/gateway/src/fileSearch/db.ts reads this via
# process.env.FILE_SEARCH_MIGRATION_DATABASE_URL (falling back to
# FILE_SEARCH_DATABASE_URL when unset, for backwards compatibility with
# installs that predate the restricted runtime role). setup-docker.js
# substitutes the user/password segments the same way it does for the
# cds.requires.db.credentials.* keys above, so this always matches the
# postgres service's bootstrap-superuser credentials.
#
# This file is loaded ONLY by the one-shot `gateway-migrate` compose
# service (docker-compose.yml), never by the long-running `gateway`
# service — the whole point of the split is that the gateway process must
# never hold DDL-capable credentials, even in its own environment. The
# gateway's own DSN (DML only) lives in the separate .env.filesearch-runtime
# file instead. See docs/developer/chapter-14-release.md.
FILE_SEARCH_MIGRATION_DATABASE_URL=postgresql://admin_user:admin_password@postgres:5432/sap_llm_gateway