# SAP LLM Gateway OAuth2 Demo - Local Development Environment
# =================================================================
# This configuration uses hardcoded test users for development only
# WARNING: Do not use in production environments!

# =================================================================
# NGINX CONFIGURATION
# =================================================================
# Nginx HTTP port (configurable to avoid conflicts with Traefik)
NGINX_HTTP_PORT=8080
# Domain name for nginx (localhost for dev, custom domain for prod)
NGINX_DOMAIN=localhost

# =================================================================
# DATABASE CONFIGURATION (Shared PostgreSQL)
# =================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sap_llm_gateway
POSTGRES_USER=admin_user
POSTGRES_PASSWORD=admin_password

# =================================================================
# IDENTITY PROVIDER CONFIGURATION
# =================================================================
# Identity provider selection: local (for development only)
IDENTITY_PROVIDER=local

# =================================================================
# GROUP MAPPING CONFIGURATION
# =================================================================
# Map external groups/users to internal application roles
# Format: JSON object with "external_group": "internal_role" mappings

# Local Users (Development Only - Maps email to role)
LOCAL_USER_MAPPING={"admin@example.com":"admin","user@example.com":"user"}

# Other providers (not used in local mode)
GITHUB_GROUP_MAPPING={}
LDAP_GROUP_MAPPING={}
OKTA_GROUP_MAPPING={}

# =================================================================
# OAUTH2-PROXY CONFIGURATION
# =================================================================
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_CLIENT_ID=oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
OAUTH2_PROXY_COOKIE_SECRET=deadbeefdeadbeefdeadbeefdeadbeef

# Basic settings
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_COOKIE_SECURE=false

# Redirect URL (nginx routing)
OAUTH2_PROXY_REDIRECT_URL=http://localhost:8080/auth/callback

# OIDC configuration (Dex integration)
OAUTH2_PROXY_OIDC_ISSUER_URL=http://dex:5556/dex
OAUTH2_PROXY_OIDC_GROUPS_CLAIM=groups
OAUTH2_PROXY_OIDC_EMAIL_CLAIM=email
OAUTH2_PROXY_SCOPE=openid email profile groups

# Debugging (set to info/warn for production)
OAUTH2_PROXY_LOGGING_LEVEL=debug
OAUTH2_PROXY_REQUEST_LOGGING=true

# Advanced OIDC settings - Required for proper Dex integration
OAUTH2_PROXY_SKIP_OIDC_DISCOVERY=true
OAUTH2_PROXY_LOGIN_URL=http://localhost:8080/dex/auth
OAUTH2_PROXY_REDEEM_URL=http://dex:5556/dex/token
OAUTH2_PROXY_OIDC_JWKS_URL=http://dex:5556/dex/keys
OAUTH2_PROXY_PROFILE_URL=http://dex:5556/dex/userinfo
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=true
OAUTH2_PROXY_PASS_USER_HEADERS=true

# Additional oauth2-proxy settings
OAUTH2_PROXY_INSECURE_OIDC_SKIP_ISSUER_VERIFICATION=false
OAUTH2_PROXY_OIDC_EXTRA_AUDIENCES=oauth2-proxy

# =================================================================
# APPLICATION CONFIGURATION
# =================================================================
# Node.js environment
NODE_ENV=development
PORT=4004