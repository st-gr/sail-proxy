# Nginx Configuration Environment Variables
# This file contains all configurable environment variables for the Nginx container

# Basic Configuration
NGINX_PORT=8080
SERVER_NAME=localhost
BASE_URL=http://localhost:8080

# JWT Configuration
JWT_ISSUER_URL=${BASE_URL}/dex
JWT_AUDIENCE=oauth2-proxy

# Logout Configuration
LOGOUT_REDIRECT_URL=${BASE_URL}/admin/app/shell/

# Service Discovery - Default values for Docker Compose
OAUTH2_PROXY_HOST=oauth2-proxy
OAUTH2_PROXY_PORT=4180
DEX_HOST=dex
DEX_PORT=5556
ADMIN_HOST=admin
ADMIN_PORT=4004
GATEWAY_HOST=gateway
GATEWAY_PORT=3000

# JWKS Configuration
JWKS_ENDPOINT=http://${DEX_HOST}:${DEX_PORT}/dex/keys
ENABLE_JWKS_CACHE=true

# Configuration Mode
# - template: Generate configs from environment variables (default)
# - volume: Use mounted configuration files
CONFIG_MODE=template