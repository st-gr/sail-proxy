# Nginx Configuration for Production Deployment
# Example configuration for production deployment with custom domain

# Basic Configuration
NGINX_PORT=8080
SERVER_NAME=sail-proxy.example.com
BASE_URL=https://sail-proxy.example.com

# JWT Configuration  
JWT_ISSUER_URL=${BASE_URL}/dex
JWT_AUDIENCE=oauth2-proxy

# Logout Configuration
LOGOUT_REDIRECT_URL=${BASE_URL}/admin/app/shell/

# Service Discovery - Kubernetes Service Names
OAUTH2_PROXY_HOST=oauth2-proxy-service
OAUTH2_PROXY_PORT=4180
DEX_HOST=dex-service
DEX_PORT=5556
ADMIN_HOST=admin-service
ADMIN_PORT=4004
GATEWAY_HOST=gateway-service
GATEWAY_PORT=3000

# JWKS Configuration
JWKS_ENDPOINT=http://${DEX_HOST}:${DEX_PORT}/dex/keys
ENABLE_JWKS_CACHE=true

# Configuration Mode
CONFIG_MODE=template