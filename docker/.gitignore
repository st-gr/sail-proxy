# Docker-specific ignore files

# Generated environment files (in docker/ root)
/.env
/.env.auth
/.env.postgres
/.env.filesearch-runtime
/.env.nginx

# Generated configuration files (in docker/ root, from old setup)
/nginx.conf
/dex.config.yaml
/okta-saml-ca.pem
# NOTE: njs/jwt.js is tracked in git and should not be ignored
# NOTE: Template files in configs/ subdirectories should be tracked in git

# Docker override files generated by setup (in docker/ root only)
/docker-compose.override.yml

# Backup directories created by setup-docker.js
backup-*

# Local test artifacts
*.log
*.tmp