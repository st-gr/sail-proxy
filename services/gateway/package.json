{
  "name": "gateway",
  "version": "0.9.3",
  "description": "SAP AI Core Multi-Provider LLM Gateway Service",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "nodemon --ignore logs/ --ignore api_config.json --ignore test/ --exec ts-node -r tsconfig-paths/register src/index.ts",
    "pretest": "pnpm --filter @sap-llm-gateway/test-utils build",
    "test": "cross-env NODE_ENV=test jest --config jest.config.json",
    "pretest:unit": "pnpm --filter @sap-llm-gateway/test-utils build",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPattern=\"test/(clients|config)/\"",
    "pretest:integration": "pnpm --filter @sap-llm-gateway/test-utils build",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPattern=\"test/integration/\"",
    "pretest:usage": "pnpm --filter @sap-llm-gateway/test-utils build",
    "test:usage": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPattern=\"usage-tracking\"",
    "pretest:watch": "pnpm --filter @sap-llm-gateway/test-utils build",
    "test:watch": "cross-env NODE_ENV=test jest --config jest.config.json --watch",
    "pretest:coverage": "pnpm --filter @sap-llm-gateway/test-utils build",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.json --coverage",
    "test:pseudonymization": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPattern=pseudonymization",
    "test:pseudonymization:integration": "ts-node -r tsconfig-paths/register --transpile-only test/test-pseudonymization.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "body-parser": "^1.20.3",
    "cross-spawn": "^7.0.5",
    "dotenv": "^16.3.1",
    "eventsource-parser": "^3.0.2",
    "express": "^4.19.2",
    "gpt-tokenizer": "^3.4.0",
    "iovalkey": "^0.3.3",
    "morgan": "^1.10.0",
    "qs": "^6.11.2",
    "sharp": "^0.33.5",
    "uuid": "^11.1.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "@sap-llm-gateway/test-utils": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "jest": "^29.0.0",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "iovalkey": "^0.3.3"
  }
}
