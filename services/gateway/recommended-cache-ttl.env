# Current (Conservative)
UNIFIED_AUTH_CACHE_TTL_SECONDS=300          # 5 minutes
UNIFIED_AUTH_TOKEN_CACHE_TTL_SECONDS=60     # 1 minute

# Recommended (Optimized)
UNIFIED_AUTH_CACHE_TTL_SECONDS=86400        # 24 hours (1 day)
UNIFIED_AUTH_TOKEN_CACHE_TTL_SECONDS=3600   # 1 hour

# Or even more aggressive
UNIFIED_AUTH_CACHE_TTL_SECONDS=604800       # 7 days  
UNIFIED_AUTH_TOKEN_CACHE_TTL_SECONDS=86400  # 24 hours