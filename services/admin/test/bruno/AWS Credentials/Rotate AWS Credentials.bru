meta {
  name: Rotate AWS Credentials
  type: http
  seq: 3
}

post {
  url: {{base_url}}/rotateAwsCredentials
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "accessKeyId": "{{created_aws_access_key_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.hasOwnProperty('success'): isTruthy
  res.body.hasOwnProperty('newAccessKeyId'): isTruthy
  res.body.hasOwnProperty('newSecretAccessKey'): isTruthy
}

script:pre-request {
  if (!bru.getVar('created_aws_access_key_id')) {
    throw new Error('No AWS access key ID available. Run "Create AWS Credentials" first.');
  }
}

script:post-response {
  if (bru.getVar('created_aws_access_key_id')) {
    // Update with new credentials
    bru.setVar('created_aws_access_key_id', res.body.newAccessKeyId);
    bru.setVar('created_aws_secret_key', res.body.newSecretAccessKey);
    
    console.log('Rotated AWS credentials. New access key:', res.body.newAccessKeyId);
  } else {
    console.log('Skipping test - no AWS access key ID available');
  }
}
