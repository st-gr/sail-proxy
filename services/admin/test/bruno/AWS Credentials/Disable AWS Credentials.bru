meta {
  name: Disable AWS Credentials
  type: http
  seq: 4
}

post {
  url: {{base_url}}/disableAwsCredentials
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "accessKeyId": "{{created_aws_access_key_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.hasOwnProperty('success'): isTruthy
  res.body.hasOwnProperty('message'): isTruthy
  res.body.success: isTruthy
}

script:pre-request {
  if (!bru.getVar('created_aws_access_key_id')) {
    throw new Error('No AWS access key ID available. Run "Create AWS Credentials" first.');
  }
}

script:post-response {
  if (bru.getVar('created_aws_access_key_id')) {
    console.log('Disabled AWS credentials:', bru.getVar('created_aws_access_key_id'));
    
    // Clear the variables since credentials are disabled
    //bru.setVar('created_aws_access_key_id', '');
    //bru.setVar('created_aws_secret_key', '');
  } else {
    console.log('Skipping test - no AWS access key ID available');
  }
}
