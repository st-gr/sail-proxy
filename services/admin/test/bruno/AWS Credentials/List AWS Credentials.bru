meta {
  name: List AWS Credentials
  type: http
  seq: 2
}

get {
  url: {{base_url}}/AwsCredentials
  body: none
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

assert {
  res.status: eq 200
  res.body.value: isDefined
  res.body.value: isArray
}

script:post-response {
  // Verify security: sensitive fields should not be exposed
  if (res.body.value.length > 0) {
    const credential = res.body.value[0];
    if (credential.hasOwnProperty('secretAccessKey')) {
      throw new Error('Should not expose secretAccessKey');
    }
    if (credential.hasOwnProperty('secretHash')) {
      throw new Error('Should not expose secretHash');
    }
    if (credential.hasOwnProperty('salt')) {
      throw new Error('Should not expose salt');
    }
  }
  
  console.log('Found', res.body.value.length, 'AWS credentials');
}