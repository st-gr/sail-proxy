meta {
  name: Create AWS Credentials
  type: http
  seq: 1
}

post {
  url: {{base_url}}/createAwsCredentials
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "userId": "{{aws_user_id}}",
    "name": "Bruno Test AWS Credentials",
    "description": "AWS credentials for testing LLM access via Bruno",
    "expiresAt": "2024-12-31T23:59:59Z",
    "permissions": [
      "bedrock:InvokeModel",
      "bedrock:InvokeModelWithResponseStream",
      "bedrock:ListFoundationModels"
    ]
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.accessKeyId: isDefined
  res.body.secretAccessKey: isDefined
}

script:post-response {
  if (res.status === 200 && res.body.accessKeyId) {
    bru.setVar('created_aws_access_key_id', res.body.accessKeyId);
    bru.setVar('created_aws_secret_key', res.body.secretAccessKey);
    bru.setVar('created_aws_region', res.body.region);
    console.log('Created AWS credentials:', res.body.accessKeyId);
    
    // Validate AWS access key format
    if (!/^AKIA[A-Z0-9]{16}$/.test(res.body.accessKeyId)) {
      throw new Error('Access key should match AWS format');
    }
    
    // Validate secret key length
    if (res.body.secretAccessKey.length !== 40) {
      throw new Error('Secret key should be 40 characters');
    }
  }
}
