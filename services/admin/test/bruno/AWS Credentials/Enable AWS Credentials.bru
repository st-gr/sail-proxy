meta {
  name: Enable AWS Credentials
  type: http
  seq: 7
}

post {
  url: {{base_url}}/enableAwsCredentials
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "accessKeyId": "{{created_aws_access_key_id}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  console.log('✓ AWS credentials enabled successfully');
  console.log('Success:', res.body.success);
  console.log('Message:', res.body.message);
}