meta {
  name: Create AWS Credentials with Permissions
  type: http
  seq: 6
}

post {
  url: {{base_url}}/createAwsCredentials
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "userId": "{{aws_user_id}}",
    "name": "Bruno Test AWS Credentials",
    "description": "Comprehensive test credentials",
    "permissions": ["bedrock:InvokeModel", "bedrock:GetModel", "bedrock:ListModels"]
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.accessKeyId: matches /^AKIA[A-Z0-9]{16}$/
  res.body.secretAccessKey: isDefined
  res.body.region: isDefined
}

script:post-response {
  if (res.status === 200 && res.body.id) {
    bru.setVar('created_aws_credential_id', res.body.id);
    bru.setVar('created_aws_access_key_id', res.body.accessKeyId);
    console.log('Created AWS Credentials:', res.body.id);
    console.log('Access Key ID:', res.body.accessKeyId);
    console.log('Region:', res.body.region);
    
    // Validate that secretAccessKey is only returned once
    if (res.body.secretAccessKey && res.body.secretAccessKey.length === 40) {
      console.log('✓ Secret access key returned (40 characters)');
    }
  } else {
    throw new Error(`Failed to create AWS credentials: ${res.status}`);
  }
}