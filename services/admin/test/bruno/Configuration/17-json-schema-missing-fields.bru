meta {
  name: JSON Schema Validation - Missing Required Fields
  type: http
  seq: 17
}

post {
  url: {{base_url}}/validateConfiguration
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "configData": "{\"wrong_root_property\":{}}"
  }
}

assert {
  res.status: eq 200
  res.body.valid: isDefined
  res.body.valid: eq false
  res.body.errors: isDefined
  res.body.errors: isType array
  res.body.errors.length: gt 0
}

script:post-response {
  console.log('✅ Missing required fields test completed');
  console.log('Valid:', res.body.valid);
  console.log('Errors:', res.body.errors);
  
  // Check for schema validation errors about missing api_config
  const hasRequiredFieldError = res.body.errors.some(error => 
    error.includes('api_config') || error.includes('required')
  );
  
  if (hasRequiredFieldError) {
    console.log('✅ Required field validation working correctly');
  } else {
    console.log('❌ Expected required field error not found');
  }
}