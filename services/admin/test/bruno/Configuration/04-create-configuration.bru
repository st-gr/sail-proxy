meta {
  name: Create New Configuration
  type: http
  seq: 4
}

post {
  url: {{base_url}}/createConfiguration
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "name": "Test Configuration",
    "description": "Configuration created via Bruno API test",
    "configData": "{\"api_config\": {\"anthropic\": {\"anthropic_bedrock_version\": \"bedrock-2023-05-31\", \"emulate_streaming_for_models\": [\"anthropic--claude-4-opus\"], \"substitute_models\": [{\"from\": \"claude-3-5-haiku-20241022\", \"to\": \"anthropic--claude-3-haiku--deployed\"}, {\"from\": \"claude-3-5-sonnet-20240229\", \"to\": \"anthropic--claude-3.5-sonnet--deployed\"}, {\"from\": \"claude-3-7-sonnet-20250219\", \"to\": \"anthropic--claude-3.7-sonnet--deployed\"}, {\"from\": \"claude-sonnet-4-20250514\", \"to\": \"anthropic--claude-4-sonnet--deployed\"}, {\"from\": \"claude-opus-4-20250514\", \"to\": \"anthropic--claude-4-opus--deployed\"}]}, \"aws-bedrock\": {\"anthropic_bedrock_version\": \"bedrock-2023-05-31\", \"emulate_streaming_for_models\": [\"anthropic--claude-4-opus\"], \"substitute_models\": [{\"from\": \"us.anthropic.claude-3-5-haiku-20241022-v1:0\", \"to\": \"anthropic--claude-3-haiku--deployed\"}, {\"from\": \"us.anthropic.claude-3-7-sonnet-20250219-v1:0\", \"to\": \"anthropic--claude-3.7-sonnet--deployed\"}, {\"from\": \"us.anthropic.claude-3-5-sonnet-20241022-v2:0\", \"to\": \"anthropic--claude-3.5-sonnet--deployed\"}, {\"from\": \"us.anthropic.claude-sonnet-4-20250514-v1:0\", \"to\": \"anthropic--claude-4-sonnet--deployed\"}, {\"from\": \"us.anthropic.claude-opus-4-20250514-v1:0\", \"to\": \"anthropic--claude-4-opus--deployed\"}]}, \"hookDefinitions\": {\"anthropic:all\": {\"desc\": \"Match any URL containing 'anthropic'\", \"flags\": \"i\", \"regex\": \"anthropic\", \"type\": \"url-regex\"}, \"header:x-app=cli\": {\"equals\": \"cli\", \"name\": \"x-app\", \"type\": \"header\"}, \"payload:maxTokens512\": {\"equals\": 512, \"path\": \"$.max_tokens\", \"type\": \"json-path\"}, \"payload:temperature1\": {\"equals\": 1, \"path\": \"$.temperature\", \"type\": \"json-path\"}, \"size:1k-3k\": {\"desc\": \"Reject anything <1 KiB or >3 KiB\", \"from\": 1024, \"name\": \"content-length\", \"to\": 3072, \"type\": \"header\"}, \"size:min10kb\": {\"desc\": \"Cache requests with content-length >= 10 KB\", \"from\": 10240, \"name\": \"content-length\", \"to\": 999999999, \"type\": \"header\"}, \"size:min61kb\": {\"desc\": \"Cache requests with content-length >= 61 KB\", \"from\": 61440, \"name\": \"content-length\", \"to\": 999999999, \"type\": \"header\"}, \"system:whimsicalPrompt\": {\"flags\": \"i\", \"path\": \"$.system.0.text\", \"regex\": \"^Analyze\\\\s+this\\\\s+message\\\\s+and\\\\s+come\\\\s+up\\\\s+with\\\\s+a\\\\s+single\\\\s+positive,\\\\s+cheerful\", \"type\": \"json-path-regex\"}}, \"logging\": {\"components\": {\"AnthropicService\": \"INFO\", \"awsBedrockResponseCache\": \"INFO\", \"AwsBedrockService\": \"DEBUG\", \"ConfigService\": \"INFO\", \"ModelService\": \"INFO\", \"openaiController\": \"INFO\", \"OpenRouterController\": \"INFO\", \"OpenRouterService\": \"INFO\", \"RateLimitManager\": \"INFO\", \"SAPAIService\": \"INFO\", \"UsageTrackingService\": \"INFO\"}, \"defaultLevel\": \"INFO\", \"log_folder_path\": \"./logs\", \"payload_logging_enabled\": false}, \"model_list_changes\": {\"amazon--nova-lite\": {\"streamingSupported\": false}, \"amazon--nova-micro\": {\"streamingSupported\": false}, \"amazon--nova-pro\": {\"streamingSupported\": false}, \"amazon--titan-text-express\": {\"streamingSupported\": false}, \"amazon--titan-text-lite\": {\"streamingSupported\": false}, \"anthropic--claude-3.5-sonnet--deployed\": {\"anthropic_version\": \"bedrock-2023-05-31\", \"streamingSupported\": true, \"subpaths_emulated\": [], \"subpaths_native\": [\"invoke\", \"invoke-with-response-stream\", \"converse\", \"converse-stream\"], \"supports_prompt_caching\": true}, \"anthropic--claude-3.7-sonnet--deployed\": {\"anthropic_version\": \"bedrock-2023-05-31\", \"hooks\": {\"invoke\": [{\"request\": {\"callback\": {\"id\": \"awsBedrockResponseCache\"}, \"match\": [\"size:min61kb\"]}}], \"invoke-with-response-stream\": [{\"request\": {\"callback\": {\"id\": \"awsBedrockResponseCache\"}, \"match\": [\"size:min61kb\"]}}]}, \"streamingSupported\": true, \"subpaths_emulated\": [\"REM woring:since:June:23:2025:invoke\", \"REM woring:since:June:23:2025:invoke-with-response-stream\"], \"subpaths_native\": [\"invoke\", \"invoke-with-response-stream\", \"converse\", \"converse-stream\"], \"supports_prompt_caching\": true}, \"anthropic--claude-3-haiku--deployed\": {\"anthropic_version\": \"bedrock-2023-05-31\", \"hooks\": {\"invoke-with-response-stream\": [{\"request\": {\"callback\": {\"id\": \"mockWhimsicalGerundVerb\", \"strategy\": \"before\"}, \"match\": [\"size:1k-3k\", \"header:x-app=cli\", \"payload:maxTokens512\", \"payload:temperature1\", \"system:whimsicalPrompt\"]}}]}, \"streamingSupported\": true, \"subpaths_emulated\": [], \"subpaths_native\": [\"invoke\", \"invoke-with-response-stream\", \"converse\", \"converse-stream\"], \"supports_prompt_caching\": false}, \"anthropic--claude-4-opus--deployed\": {\"anthropic_version\": \"bedrock-2023-05-31\", \"hooks\": {\"invoke\": [{\"request\": {\"callback\": {\"id\": \"awsBedrockResponseCache\"}, \"match\": [\"size:min61kb\"]}}], \"invoke-with-response-stream\": [{\"request\": {\"callback\": {\"id\": \"awsBedrockResponseCache\"}, \"match\": [\"size:min61kb\"]}}]}, \"streamingSupported\": true, \"subpaths_emulated\": [], \"subpaths_native\": [\"invoke\", \"invoke-with-response-stream\", \"converse\", \"converse-stream\"], \"supports_prompt_caching\": true}, \"anthropic--claude-4-sonnet--deployed\": {\"anthropic_version\": \"bedrock-2023-05-31\", \"hooks\": {\"invoke\": [{\"request\": {\"callback\": {\"id\": \"removeEmptyAssistantMessages\"}, \"match\": [\"header:x-app=cli\"]}}, {\"request\": {\"callback\": {\"id\": \"awsBedrockResponseCache\"}, \"match\": [\"size:min61kb\"]}}], \"invoke-with-response-stream\": [{\"request\": {\"callback\": {\"id\": \"removeEmptyAssistantMessages\"}, \"match\": [\"header:x-app=cli\"]}}, {\"request\": {\"callback\": {\"id\": \"awsBedrockResponseCache\"}, \"match\": [\"size:min61kb\"]}}]}, \"streamingSupported\": true, \"subpaths_emulated\": [], \"subpaths_native\": [\"invoke\", \"invoke-with-response-stream\", \"converse\", \"converse-stream\"], \"supports_prompt_caching\": true}, \"gpt-35-turbo-0125\": {\"streamingSupported\": false}, \"mistralai--mistral-large-instruct\": {\"streamingSupported\": false}, \"mistralai--mistral-small-instruct\": {\"streamingSupported\": false}, \"o1\": {\"streamingSupported\": false}, \"o3-mini\": {\"streamingSupported\": false}, \"REM woring:since:June:23:2025:anthropic--claude-3.7-sonnet\": {\"streamingSupported\": true}}, \"openai\": {\"emulate_streaming_for_models\": [\"REM woring:since:June:23:2025:anthropic--claude-3.7-sonnet\", \"anthropic--claude-4-opus\"], \"openai_deployment_api_version\": \"2024-10-01-preview\", \"substitute_models\": [{\"from\": \"GPT-4\", \"to\": \"o1\"}, {\"from\": \"GPT-3.5\", \"to\": \"GPT-4\"}]}, \"openrouter\": {\"default_pricing\": {\"completion\": \"0.000005\", \"image\": \"0.001\", \"prompt\": \"0.000001\"}, \"model_mappings\": [{\"default_context_length\": 128000, \"id_prefix\": \"openai\", \"provider\": \"OpenAI\"}, {\"default_context_length\": 200000, \"id_prefix\": \"anthropic\", \"max_tokens\": 4096, \"provider\": \"Anthropic\"}, {\"default_context_length\": 1000000, \"id_prefix\": \"google\", \"provider\": \"Google\"}, {\"default_context_length\": 128000, \"id_prefix\": \"mistralai\", \"provider\": \"Mistral AI\"}], \"substitute_models\": [{\"from\": \"gemini-2.5-flash-lite-preview-06-17\", \"to\": \"gemini-2.5-flash\"}]}, \"rate_limit_handling\": {\"backoff_multiplier\": 1.5, \"default_delay_seconds\": 30, \"enabled\": true, \"max_delay_seconds\": 300, \"model_specific_delays\": {\"anthropic--claude-3.5-sonnet--deployed\": 30, \"anthropic--claude-3.7-sonnet--deployed\": 45, \"anthropic--claude-3-haiku--deployed\": 20, \"anthropic--claude-4-opus--deployed\": 90, \"anthropic--claude-4-sonnet--deployed\": 17}, \"subpath_specific_delays\": {\"converse-stream\": 25, \"invoke-with-response-stream\": 35}}, \"timeouts\": {\"default\": 600000, \"streaming\": 600000}}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.configId: isDefined
  res.body.version: isDefined
  res.body.checksum: isDefined
}

script:post-response {
  console.log('✅ Configuration created successfully');
  console.log('Config ID:', res.body.configId);
  console.log('Version:', res.body.version);
  console.log('Checksum:', res.body.checksum);
  
  if (res.body.warnings && res.body.warnings.length > 0) {
    console.log('Warnings:', res.body.warnings);
  }
  
  // Store created config details for later tests
  bru.setVar('new_config_id', res.body.configId);
  bru.setVar('new_config_version', res.body.version);
  bru.setVar('new_config_checksum', res.body.checksum);
}
