meta {
  name: Get AWS Credential by Access Key ID copy
  type: http
  seq: 4
}

get {
  url: {{base_url}}/getAwsCredentialByAccessKeyId(accessKeyId='{{created_aws_access_key_id}}')
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

assert {
  res.status: eq 200
}

script:pre-request {
  const accessKeyId = bru.getVar('created_aws_access_key_id');
  if (!accessKeyId) {
    throw new Error('This test requires created_aws_access_key_id from "Create AWS Credentials" test. Please run that test first.');
  }
}

script:post-response {
  if (res.body.found) {
    console.log('✓ AWS Credential found successfully');
    console.log('Credential ID:', res.body.credentialInfo.id);
    console.log('User ID:', res.body.credentialInfo.userId);
    console.log('Name:', res.body.credentialInfo.name);
    console.log('Active:', res.body.credentialInfo.isActive);
    console.log('Region:', res.body.credentialInfo.region);
    console.log('Permissions:', res.body.credentialInfo.permissions);
  } else {
    console.log('⚠ AWS Credential not found');
    console.log('Response:', res.body);
  }
}
