meta {
  name: Query AWS Credential Security Events
  type: http
  seq: 4
}

get {
  url: {{base_url}}/AwsCredentialSecurityEvents
  body: none
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

assert {
  res.status: eq 200
  res.body.value: isDefined
  res.body.value: isType array
}

script:post-response {
  console.log('Found', res.body.value.length, 'AWS credential security events');
}