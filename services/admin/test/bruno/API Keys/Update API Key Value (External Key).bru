meta {
  name: Update API Key Value (User Own Key)
  type: http
  seq: 13
}

post {
  url: {{base_url}}/updateApiKeyValue
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: 
}

body:json {
  {
    "keyId": "{{created_api_key_id}}",
    "newKey": "{{ANTHROPIC_API_KEY}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.message: eq "API key updated successfully"
}

script:pre-request {
  // Check if we have a created API key ID from previous tests
  const apiKeyId = bru.getVar('created_api_key_id');
  if (!apiKeyId) {
    throw new Error('This test requires created_api_key_id from "Create API Key" test. Please run that test first.');
  }
  
  // Validate our test key is exactly 128 characters
  const testKey = req.body.newKey;
  if (testKey.length > 128) {
    throw new Error(`Test key must not exceed 128 characters, got ${testKey.length}`);
  }
}

script:post-response {
  if (res.body.success) {
    console.log(`User successfully updated their own API key ${bru.getVar('created_api_key_id')} with external key`);
    bru.setVar('external_key_updated', true);
  } else {
    throw new Error(`Failed to update API key: ${res.body.message}`);
  }
}
