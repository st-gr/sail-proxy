meta {
  name: Create API Key
  type: http
  seq: 1
}

post {
  url: {{base_url}}/createApiKey
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "name": "Bruno Test API Key",
    "email": "{{test_email}}",
    "permissions": ["models:read", "chat:create"],
    "rateLimits": {
      "requestsPerMinute": 60,
      "requestsPerHour": 1000,
      "requestsPerDay": 5000
    }
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.key: isDefined
  res.body.maskedKey: isDefined
  res.body.name: eq "Bruno Test API Key"
}

script:post-response {
  if (res.status === 200 && res.body.id) {
    bru.setVar('created_api_key_id', res.body.id);
    bru.setVar('created_api_key', res.body.key);
    bru.setVar('api_key_set_by_collection_script', res.body.key);
    console.log('Created API Key:', res.body.id);
  }
}
