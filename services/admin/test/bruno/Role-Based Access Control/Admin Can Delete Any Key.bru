meta {
  name: Admin Can Delete Any API Key
  type: http
  seq: 18
}

post {
  url: {{base_url}}/deleteApiKey
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "keyId": "{{other_user_api_key_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.message: eq "API key deleted successfully"
}

script:pre-request {
  // Check if we have other user API key ID from RBAC tests
  const otherUserApiKeyId = bru.getVar('other_user_api_key_id');
  if (!otherUserApiKeyId) {
    throw new Error('This test requires other_user_api_key_id from RBAC tests. Please run "Create Other User API Key" test first.');
  }
}

script:post-response {
  if (res.body.success) {
    console.log(`✓ Admin successfully deleted other user's API key ${bru.getVar('other_user_api_key_id')}`);
    // Clear the variable since key is deleted
    bru.setVar('other_user_api_key_id', '');
  } else {
    throw new Error(`Failed to delete API key: ${res.body.message}`);
  }
}