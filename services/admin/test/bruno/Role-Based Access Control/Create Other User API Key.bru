meta {
  name: Create Other User API Key
  type: http
  seq: 2
}

post {
  url: {{base_url}}/createApiKey
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "name": "Other User Key",
    "email": "{{other_user_email}}",
    "permissions": ["models:read"],
    "rateLimits": {
      "requestsPerMinute": 50,
      "requestsPerHour": 1000,
      "requestsPerDay": 5000
    }
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.key: isDefined
  res.body.email: eq {{other_user_email}}
  res.body.name: eq "Other User Key"
  res.body.isActive: eq true
}

script:post-response {
  // Store the other user's API key for RBAC tests
  if (res.body && res.body.id) {
    bru.setVar('other_user_api_key_id', res.body.id);
    bru.setVar('other_user_api_key', res.body.key);
    console.log(`Created other user API key: ${res.body.id} for ${res.body.email}`);
  } else {
    throw new Error('Failed to create other user API key');
  }
}