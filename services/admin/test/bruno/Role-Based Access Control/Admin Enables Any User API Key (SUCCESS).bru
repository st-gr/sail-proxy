meta {
  name: Admin Enables Any User API Key (SUCCESS)
  type: http
  seq: 5
}

post {
  url: {{base_url}}/enableApiKey
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "keyId": "{{user_api_key_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.message: contains "enabled successfully"
}

script:pre-request {
  // Check if we have the required user API key
  const userApiKeyId = bru.getVar('user_api_key_id');
  if (!userApiKeyId) {
    throw new Error('This test requires user_api_key_id from "Create User API Key" test. Please run that test first.');
  }
}

script:post-response {
  if (res.body.success) {
    console.log(`✓ Admin successfully enabled user API key: ${bru.getVar('user_api_key_id')}`);
    console.log(`Message: ${res.body.message}`);
    bru.setVar('admin_enabled_user_key', true);
  } else {
    throw new Error(`Failed to enable API key: ${res.body.message}`);
  }
}