meta {
  name: User Disables Own API Key (SUCCESS)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/disableApiKey
  body: json
  auth: basic
}

auth:basic {
  username: user@test.com
  password: user
}

body:json {
  {
    "keyId": "{{user_api_key_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.message: contains "disabled successfully"
}

script:pre-request {
  // Check if we have the required user API key
  const userApiKeyId = bru.getVar('user_api_key_id');
  if (!userApiKeyId) {
    throw new Error('This test requires user_api_key_id from "Create User API Key" test. Please run that test first.');
  }
}

script:post-response {
  if (res.body.success) {
    console.log(`✓ User successfully disabled their own API key: ${bru.getVar('user_api_key_id')}`);
    console.log(`Message: ${res.body.message}`);
    bru.setVar('user_disabled_own_key', true);
  } else {
    throw new Error(`Failed to disable API key: ${res.body.message}`);
  }
}