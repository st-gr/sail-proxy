meta {
  name: User Disables Own API Key
  type: http
  seq: 16
}

post {
  url: {{base_url}}/disableApiKey
  body: json
  auth: basic
}

auth:basic {
  username: user@test.com
  password: user
}

body:json {
  {
    "keyId": "{{user_api_key_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.message: eq "API key disabled successfully"
}

script:pre-request {
  // Check if we have user API key ID from RBAC tests
  const userApiKeyId = bru.getVar('user_api_key_id');
  if (!userApiKeyId) {
    throw new Error('This test requires user_api_key_id from RBAC tests. Please run "Create User API Key" test first.');
  }
}

script:post-response {
  if (res.body.success) {
    console.log(`✓ User successfully disabled their own API key ${bru.getVar('user_api_key_id')}`);
    bru.setVar('user_disabled_key_id', bru.getVar('user_api_key_id'));
  } else {
    throw new Error(`Failed to disable API key: ${res.body.message}`);
  }
}