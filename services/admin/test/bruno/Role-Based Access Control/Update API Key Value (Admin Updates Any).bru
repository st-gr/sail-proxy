meta {
  name: Update API Key Value (Admin Updates Any)
  type: http
  seq: 15
}

post {
  url: {{base_url}}/updateApiKeyValue
  body: json
  auth: basic
}

auth:basic {
  username: admin@test.com
  password: admin
}

body:json {
  {
    "keyId": "{{other_user_api_key_id}}",
    "newKey": "sk-admin-external-key-update-abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.message: eq "API key updated successfully"
}

script:pre-request {
  // Check if we have other user API key ID from RBAC tests
  const otherUserApiKeyId = bru.getVar('other_user_api_key_id');
  if (!otherUserApiKeyId) {
    throw new Error('This test requires other_user_api_key_id from RBAC tests. Please run "Create Other User API Key" test first.');
  }
  
  // Validate our test key is exactly 128 characters
  const testKey = "sk-admin-external-key-update-abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789";
  if (testKey.length !== 128) {
    throw new Error(`Test key should be exactly 128 characters, got ${testKey.length}`);
  }
}

script:post-response {
  if (res.body.success) {
    console.log(`Admin successfully updated other user's API key ${bru.getVar('other_user_api_key_id')} with external key`);
    bru.setVar('admin_external_key_updated', true);
  } else {
    throw new Error(`Failed to update API key: ${res.body.message}`);
  }
}