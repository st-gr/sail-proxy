{
  "api_config": {
    "timeouts": {
      "default": 600000,
      "streaming": 600000
    },
    "logging": {
      "components": {
        "AnthropicService": "INFO",
        "awsBedrockResponseCache": "INFO",
        "AwsBedrockService": "INFO",
        "ConfigService": "INFO",
        "ModelService": "INFO",
        "openaiController": "INFO",
        "OpenRouterController": "INFO",
        "OpenRouterService": "INFO",
        "RateLimitManager": "INFO",
        "SAPAIService": "INFO",
        "UsageTrackingService": "INFO"
      },
      "defaultLevel": "INFO",
      "log_folder_path": "./logs",
      "payload_logging_enabled": false
    },
    "hookDefinitions": {
      "anthropic:all": {
        "desc": "Match any URL containing 'anthropic'",
        "flags": "i",
        "regex": "anthropic",
        "type": "url-regex"
      },
      "header:x-app=cli": {
        "equals": "cli",
        "name": "x-app",
        "type": "header"
      },
      "payload:maxTokens512": {
        "equals": 512,
        "path": "$.max_tokens",
        "type": "json-path"
      },
      "payload:temperature1": {
        "equals": 1,
        "path": "$.temperature",
        "type": "json-path"
      },
      "size:1k-3k": {
        "desc": "Reject anything <1 KiB or >3 KiB",
        "from": 1024,
        "name": "content-length",
        "to": 3072,
        "type": "header"
      },
      "size:min10kb": {
        "desc": "Cache requests with content-length >= 10 KB",
        "from": 10240,
        "name": "content-length",
        "to": 999999999,
        "type": "header"
      },
      "size:min61kb": {
        "desc": "Cache requests with content-length >= 61 KB",
        "from": 61440,
        "name": "content-length",
        "to": 999999999,
        "type": "header"
      },
      "system:whimsicalPrompt": {
        "flags": "i",
        "path": "$.system.0.text",
        "regex": "^Analyze\\s+this\\s+message\\s+and\\s+come\\s+up\\s+with\\s+a\\s+single\\s+positive,\\s+cheerful",
        "type": "json-path-regex"
      },
      "tools:hasWebSearch": {
        "desc": "Match requests containing web_search tool",
        "type": "json-path-regex",
        "path": "$.tools",
        "regex": "web_search",
        "flags": "i"
      },
      "payload:any": {
        "type": "json-path-regex",
        "path": "$.model",
        "regex": ".",
        "flags": ""
      },
      "header:contentTypeJson": {
        "type": "header",
        "name": "content-type",
        "equals": "application/json"
      }
    },
    "defaultHooks": {
      "anthropic": {
        "pseudonymization": { "enabled": true, "method": "pseudonymization", "allow_user_bypass": false },
        "invoke": [
          {
            "request": {
              "callback": { "id": "pseudonymizationPlugin" },
              "match": ["header:contentTypeJson"]
            }
          }
        ],
        "invoke-with-response-stream": [
          {
            "request": {
              "callback": { "id": "pseudonymizationPlugin" },
              "match": ["header:contentTypeJson"]
            }
          }
        ]
      },
      "openai": {
        "pseudonymization": { "enabled": true, "method": "pseudonymization", "allow_user_bypass": false },
        "invoke": [
          {
            "request": {
              "callback": { "id": "pseudonymizationPlugin" },
              "match": ["header:contentTypeJson"]
            }
          }
        ],
        "invoke-with-response-stream": [
          {
            "request": {
              "callback": { "id": "pseudonymizationPlugin" },
              "match": ["header:contentTypeJson"]
            }
          }
        ]
      },
      "aws-bedrock": {
        "pseudonymization": { "enabled": true, "method": "pseudonymization", "allow_user_bypass": false },
        "invoke": [
          {
            "request": {
              "callback": { "id": "pseudonymizationPlugin" },
              "match": ["header:contentTypeJson"]
            }
          }
        ],
        "invoke-with-response-stream": [
          {
            "request": {
              "callback": { "id": "pseudonymizationPlugin" },
              "match": ["header:contentTypeJson"]
            }
          }
        ]
      }
    },
