<mvc:View
    controllerName="admin.config.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:codeeditor="sap.ui.codeeditor"
    xmlns:form="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
    xmlns:mdc="sap.ui.mdc">
    
    <f:FlexibleColumnLayout id="fcl" 
                                layout="OneColumn">
        
        <!-- Master Column - Configuration List -->
        <f:beginColumnPages>
            <f:DynamicPage id="dynamicPage">
                <f:title>
                    <f:DynamicPageTitle>
                        <f:heading>
                            <Title text="{i18n>appTitle}"/>
                        </f:heading>
                    </f:DynamicPageTitle>
                </f:title>
                <f:header>
                    <f:DynamicPageHeader>
                        <!-- Modern Inline FilterBar using HBox layout -->
                        <HBox alignItems="Center" class="sapUiTinyMargin" wrap="Wrap">
                            <!-- Search Field -->
                            <VBox class="sapUiTinyMarginEnd">
                                <Label text="{i18n>search}" class="sapUiTinyMarginBottom"/>
                                <SearchField id="searchField" 
                                           placeholder="{i18n>searchPlaceholder}"
                                           search="onSearchFieldSearch"
                                           liveChange="onSearchFieldLiveChange"
                                           width="20rem"/>
                            </VBox>
                            
                            <!-- Status Filter -->
                            <VBox class="sapUiTinyMarginEnd">
                                <Label text="{i18n>status}" class="sapUiTinyMarginBottom"/>
                                <Select id="statusFilter" 
                                      selectedKey="{viewModel>/filters/status}"
                                      change="onFilterChange"
                                      width="10rem">
                                    <core:Item key="" text="{i18n>filterAll}"/>
                                    <core:Item key="active" text="{i18n>active}"/>
                                    <core:Item key="inactive" text="{i18n>inactive}"/>
                                </Select>
                            </VBox>
                            
                            <!-- Validation Filter -->
                            <VBox class="sapUiTinyMarginEnd">
                                <Label text="{i18n>validation}" class="sapUiTinyMarginBottom"/>
                                <Select id="validationFilter" 
                                      selectedKey="{viewModel>/filters/validation}"
                                      change="onFilterChange"
                                      width="10rem">
                                    <core:Item key="" text="{i18n>filterAll}"/>
                                    <core:Item key="valid" text="{i18n>valid}"/>
                                    <core:Item key="invalid" text="{i18n>invalid}"/>
                                </Select>
                            </VBox>
                            
                            <!-- Name Filter -->
                            <VBox class="sapUiTinyMarginEnd">
                                <Label text="{i18n>name}" class="sapUiTinyMarginBottom"/>
                                <Input id="nameFilter" 
                                     value="{viewModel>/filters/name}" 
                                     placeholder="{i18n>nameFilterPlaceholder}"
                                     liveChange="onFilterChange"
                                     width="15rem"/>
                            </VBox>
                            
                            <!-- Action Buttons with field-like spacing -->
                            <VBox class="sapUiTinyMarginEnd">
                                <Label text=" " class="sapUiTinyMarginBottom"/> <!-- Empty label for alignment -->
                                <Button text="{i18n>go}" 
                                      press="onApplyFilters" 
                                      type="Emphasized"/>
                            </VBox>
                            
                            <VBox>
                                <Label text=" " class="sapUiTinyMarginBottom"/> <!-- Empty label for alignment -->
                                <Button text="{i18n>clear}" 
                                      icon="sap-icon://clear-filter"
                                      press="onClearFilters"/>
                            </VBox>
                        </HBox>
                    </f:DynamicPageHeader>
                </f:header>
                <f:content>
                    <!-- Configuration Table -->
                    <Table id="configTable" 
                           items="{path: '/ApiConfigurations', parameters: {$select: 'description,modifiedBy'}, sorter: {path: 'modifiedAt', descending: true}}"
                           mode="MultiSelect"
                           itemPress="onItemPress"
                           selectionChange="onSelectionChange"
                           updateFinished="onConfigListUpdateFinished"
                           growing="true"
                           growingThreshold="50"
                           sticky="ColumnHeaders,HeaderToolbar"
                           class="sapUiResponsiveMargin">
                        <!-- Delete, Duplicate and Activate act on the ticked rows only (model/selectionState.ts);
                             the pressed row is the detail's and is marked as navigated. -->
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="{i18n>configurations}" id="tableTitle"/>
                                <ToolbarSpacer/>
                                <Button text="{i18n>create}" 
                                        icon="sap-icon://add" 
                                        press="onNewConfiguration" 
                                        type="Emphasized"/>
                                <Button text="{i18n>rollback}" 
                                        icon="sap-icon://undo" 
                                        press="onRollbackConfiguration" 
                                        type="Critical"
                                        tooltip="{i18n>rollbackTooltip}"/>
                                <ToolbarSeparator/>
                                <Button text="{i18n>delete}" 
                                        icon="sap-icon://delete" 
                                        press="onDeleteConfiguration" 
                                        enabled="{viewModel>/toolbar/canDelete}"
                                        type="Reject"/>
                                <Button text="{i18n>duplicate}" 
                                        icon="sap-icon://copy" 
                                        press="onDuplicateConfiguration" 
                                        enabled="{viewModel>/toolbar/canDuplicate}"
                                        tooltip="{i18n>duplicate}"/>
                                <ToolbarSeparator/>
                                <Button text="{i18n>activate}" 
                                        icon="sap-icon://activate" 
                                        press="onActivateConfiguration" 
                                        enabled="{viewModel>/toolbar/canActivate}"
                                        type="Emphasized"/>
                                <Button text="{i18n>refresh}" 
                                        icon="sap-icon://refresh" 
                                        press="onRefresh"/>
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="20%" minScreenWidth="Tablet" demandPopin="true" hAlign="Left">
                                <Text text="{i18n>configuration}" class="sapMTextBold"/>
                            </Column>
                            <Column width="8%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" hAlign="Center">
                                <Text text="{i18n>version}" class="sapMTextBold"/>
                            </Column>
                            <Column width="25%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Block" hAlign="Left">
                                <Text text="{i18n>description}" class="sapMTextBold"/>
                            </Column>
                            <Column width="10%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" hAlign="Center">
                                <Text text="{i18n>status}" class="sapMTextBold"/>
                            </Column>
                            <Column width="8%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" hAlign="Center">
                                <Text text="{i18n>valid}" class="sapMTextBold"/>
                            </Column>
                            <Column width="15%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" hAlign="Left">
                                <Text text="{i18n>lastModified}" class="sapMTextBold"/>
                            </Column>
                            <Column width="14%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" hAlign="Left">
                                <Text text="{i18n>created}" class="sapMTextBold"/>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Active"
                                            navigated="{= ${path:'ID',targetType:'any'} === ${viewModel>/selectedConfigId} }">
                                <cells>
                                    <!-- Configuration Name & ID -->
                                    <VBox>
                                        <Text text="{name}" class="sapMTextBold"/>
                                        <Text text="{ID}" class="sapMTextSmall sapMTextMuted"/>
                                    </VBox>
                                    
                                    <!-- Version -->
                                    <Text text="{version}" class="sapMTextMonospace"/>
                                    
                                    <!-- Description -->
                                    <Text text="{= ${description} ? ${description} : ${i18n>noDescription}}" 
                                          maxLines="2" 
                                          class="{= ${description} ? 'sapMTextWrap' : 'sapMTextSmall sapMTextMuted'}"/>
                                    
                                    <!-- Status -->
                                    <ObjectStatus 
                                        text="{ parts: [{path:'isActive', targetType:'any'}, {path:'i18n>active'}, {path:'i18n>inactive'}], formatter: '.activeText' }"
                                        state="{ parts: [{path:'isActive', targetType:'any'}], formatter: '.activeState' }"
                                        icon="{ parts: [{path:'isActive', targetType:'any'}], formatter: '.activeIcon' }"/>
                                    
                                    <!-- Validation Status -->
                                    <ObjectStatus 
                                        text="{= ${path:'isValid',targetType:'any'} ? ${i18n>valid} : ${i18n>invalid}}"
                                        state="{= ${path:'isValid',targetType:'any'} ? 'Success' : 'Error'}"
                                        icon="{= ${path:'isValid',targetType:'any'} ? 'sap-icon://message-success' : 'sap-icon://message-error'}"
                                        visible="{= ${isValid} !== null &amp;&amp; ${isValid} !== undefined}"/>
                                    
                                    <!-- Last Modified -->
                                    <VBox>
                                        <Text text="{path: 'modifiedAt', targetType: 'any', formatter: '.formatDate'}" 
                                              class="sapMTextSmall"/>
                                        <Text text="{ parts: [{path:'i18n>byUser'}, {path:'modifiedBy'}], formatter: '.formatPattern' }" 
                                              visible="{= !!${path:'modifiedBy',targetType:'any'}}"
                                              class="sapMTextSmall sapMTextMuted"/>
                                    </VBox>
                                    
                                    <!-- Created Date -->
                                    <Text text="{path: 'createdAt', targetType: 'any', formatter: '.formatDate'}" 
                                          class="sapMTextSmall"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </f:content>
            </f:DynamicPage>
        </f:beginColumnPages>

        <!-- Detail Column - JSON Editor -->
        <f:midColumnPages>
            <f:DynamicPage id="detailDynamicPage"
                           toggleHeaderOnTitleClick="false"
                           preserveHeaderStateOnScroll="true">
                <f:title>
                    <f:DynamicPageTitle>
                        <f:heading>
                            <Title text="{
                                parts: [
                                    'viewModel>/selectedConfigName',
                                    'viewModel>/selectedConfigVersion',
                                    'i18n>configDetails'
                                ],
                                formatter: '.formatConfigTitle'
                            }"/>
                        </f:heading>
                        <f:actions>
                            <!-- JSON / form toggle. Disabled only when the document fails schema
                                 validation and cannot be represented faithfully; the reason is in
                                 the tooltip. Being active or non-admin does not disable it - it
                                 makes the resulting form read-only. -->
                            <SegmentedButton id="configViewToggle"
                                    selectedKey="{viewModel>/configViewMode}"
                                    selectionChange=".onConfigViewModeChange"
                                    enabled="{viewModel>/formGateEnabled}"
                                    tooltip="{viewModel>/formGateReason}"
                                    visible="{= ${viewModel>/selectedConfigId} !== null}">
                                <items>
                                    <SegmentedButtonItem key="form" text="{i18n>viewModeForm}" icon="sap-icon://form"/>
                                    <SegmentedButtonItem key="json" text="{i18n>viewModeJson}" icon="sap-icon://syntax"/>
                                </items>
                            </SegmentedButton>
                            <!-- The open configuration's own actions (the toolbar's act on the ticked
                                 rows). Activate shows while this row is inactive - its own row state. -->
                            <Button text="{i18n>activate}"
                                    icon="sap-icon://activate"
                                    press="onActivateOpenConfiguration"
                                    visible="{= ${viewModel>/selectedConfigId} !== null &amp;&amp; !${path:'isActive',targetType:'any'}}"
                                    enabled="{= ${path:'isValid',targetType:'any'} === true}"/>
                            <Button text="{i18n>duplicate}"
                                    icon="sap-icon://copy"
                                    press="onDuplicateOpenConfiguration"
                                    visible="{= ${viewModel>/selectedConfigId} !== null}"/>
                            <!-- Cancel / Validate / Save act on the JSON editor. In form
                                 view that editor is hidden, so they are hidden with it: exactly
                                 one Save is reachable at a time, and it is the one that owns the
                                 document the user can see. -->
                            <Button text="{i18n>cancel}"
                                    icon="sap-icon://decline"
                                    press="onCancelEdits"
                                    visible="{= ${viewModel>/isEditMode} &amp;&amp; !${viewModel>/formViewActive}}"/>
                            <Button text="{i18n>validate}" 
                                    icon="sap-icon://validate" 
                                    press="onValidateConfiguration" 
                                    enabled="{= ${viewModel>/selectedConfigId} !== null}"
                                    visible="{= !${viewModel>/formViewActive}}"
                                    type="Ghost"/>
                            <Button text="{i18n>save}" 
                                    icon="sap-icon://save" 
                                    press="onSaveConfiguration" 
                                    enabled="{= ${viewModel>/selectedConfigId} !== null &amp;&amp; !${viewModel>/selectedConfigIsActive}}"
                                    visible="{= ${viewModel>/isEditMode} &amp;&amp; !${viewModel>/formViewActive}}"
                                    type="Accept"/>
                            <Button icon="sap-icon://decline" 
                                    press="onCloseDetail" 
                                    tooltip="{i18n>close}"/>
                        </f:actions>
                        <!-- The configuration's info and stored validation messages. In the title because
                             the title is the one part of the page both views show: the form view hides
                             f:content (ConfigForm._setJsonVisible) and the JSON view hides the form inside
                             f:header. Name and version are the heading above. Shown, not edited: an input
                             two-way bound to the OData V4 row would PATCH on every change, past Save and its
                             validation. This stays expanded only while preserveHeaderStateOnScroll holds,
                             which DynamicPage ignores whenever its header is taller than 60% of the page -
                             see the comment at f:header. The controller labels both groups for screen
                             readers (_labelDetailGroups). -->
                        <f:expandedContent>
                            <VBox id="detailInfo" visible="{= !!${viewModel>/selectedConfigId}}">
                                <Text text="{description}"
                                      visible="{= !!${path:'description',targetType:'any'}}"
                                      class="sapUiTinyMarginBottom"/>
                                <FlexBox wrap="Wrap" alignItems="Center">
                                    <ObjectStatus
                                        title="{i18n>status}"
                                        text="{ parts: [{path:'isActive', targetType:'any'}, {path:'i18n>active'}, {path:'i18n>inactive'}], formatter: '.activeText' }"
                                        state="{ parts: [{path:'isActive', targetType:'any'}], formatter: '.activeState' }"
                                        icon="{ parts: [{path:'isActive', targetType:'any'}], formatter: '.activeIcon' }"
                                        class="sapUiMediumMarginEnd"/>
                                    <ObjectStatus
                                        title="{i18n>validation}"
                                        text="{= ${path:'isValid',targetType:'any'} ? ${i18n>valid} : ${i18n>invalid}}"
                                        state="{= ${path:'isValid',targetType:'any'} ? 'Success' : 'Error'}"
                                        icon="{= ${path:'isValid',targetType:'any'} ? 'sap-icon://message-success' : 'sap-icon://message-error'}"
                                        visible="{= ${isValid} !== undefined}"
                                        class="sapUiMediumMarginEnd"/>
                                    <ObjectAttribute
                                        title="{i18n>lastModified}"
                                        text="{ parts: [{path:'i18n>modifiedAtBy'}, {path:'i18n>dateAtTime'}, {path:'modifiedAt', targetType:'any'}, {path:'modifiedBy'}], formatter: '.formatModifiedAtBy' }"
                                        class="sapUiMediumMarginEnd"/>
                                    <ObjectAttribute
                                        title="{i18n>checksum}"
                                        text="{checksum}"
                                        class="cfgDetailChecksum"/>
                                </FlexBox>
                                <!-- The stored validationErrors / validationWarnings, one strip per entry (the
                                     service stores them as JSON arrays; the controller unpacks them with
                                     model/storedValidation.ts). Hidden when there are none; capped in height
                                     (css/style.css) so a long list scrolls instead of pushing the form or the
                                     editor off the screen. -->
                                <VBox id="detailValidation"
                                      visible="{= ${viewModel>/selectedValidationMessages}.length > 0}"
                                      items="{path: 'viewModel>/selectedValidationMessages', templateShareable: false}"
                                      class="sapUiTinyMarginTop cfgDetailValidation">
                                    <MessageStrip
                                        text="{viewModel>text}"
                                        type="{viewModel>type}"
                                        showIcon="true"
                                        class="sapUiTinyMarginBottom"/>
                                </VBox>
                            </VBox>
                        </f:expandedContent>
                    </f:DynamicPageTitle>
                </f:title>
                <!-- The form view. It lives in the header so that it and the JSON editor below can be
                     shown one at a time without either being rebuilt: ConfigForm hides f:content's
                     wrapper while the form is open (_setJsonVisible), and the form panel inside this
                     header shows only while /formViewActive.
                     The header itself stays visible in both views on purpose. DynamicPage ignores
                     preserveHeaderStateOnScroll while its header is taller than 60% of the page (the open
                     form is), and re-measures that only when the header's own box resizes. Hiding the
                     header with visible="false" replaces its box without a resize, so the JSON view kept
                     the form-sized verdict and its title snapped (taking the info above with it) on
                     scroll. A header that stays, and only shrinks to nothing, is re-measured
                     (cfgDetailHeaderIdle, toggled by ConfigForm._setJsonVisible, drops its padding). -->
                <f:header>
                    <f:DynamicPageHeader id="detailDynamicPageHeader"
                                         pinnable="false"
                                         class="cfgDetailHeaderIdle">
                        <core:Fragment fragmentName="admin.config.view.ConfigForm" type="XML"/>
                    </f:DynamicPageHeader>
                </f:header>
                <!-- DynamicPage's content aggregation is 0..1: it holds exactly one control, and a
                     second child would silently orphan the first. Everything the JSON view shows below
                     the title therefore sits in this one wrapper. -->
                <f:content>
                    <VBox id="detailContent">
                        <VBox visible="{= !!${viewModel>/selectedConfigId}}" class="sapUiMediumMargin">

                            <!-- JSON Editor -->
                            <Panel headerText="{i18n>configDataJson}" expandable="true" expanded="true">
                                <content>
                                    <!-- Read-only warning for active configurations -->
                                    <MessageStrip 
                                        text="{i18n>formActiveReadOnly}"
                                        type="Information"
                                        visible="{viewModel>/selectedConfigIsActive}"
                                        class="sapUiMediumMarginBottom"/>
                                    <codeeditor:CodeEditor 
                                        id="jsonEditor"
                                        type="json"
                                        height="70vh"
                                        width="100%"
                                        editable="{viewModel>/isEditMode}"
                                        change="onConfigDataChange"/>
                                </content>
                            </Panel>
                        
                        </VBox>

                        <!-- Empty State -->
                        <VBox visible="{= !${viewModel>/selectedConfigId}}" 
                              alignItems="Center" 
                              justifyContent="Center" 
                              class="sapUiLargeMargin">
                            <core:Icon src="sap-icon://settings" size="4rem" color="#666"/>
                            <Title text="{i18n>configDetails}" level="H2" class="sapUiMediumMarginTop"/>
                            <Text text="{i18n>selectConfigText}" 
                                  class="sapUiMediumMarginTop"/>
                        </VBox>
                    </VBox>
                </f:content>
            </f:DynamicPage>
        </f:midColumnPages>
        
        <!-- End Column - Placeholder to silence warnings -->
        <f:endColumnPages>
            <f:DynamicPage id="endPlaceholder" visible="false"/>
        </f:endColumnPages>
    </f:FlexibleColumnLayout>
    
    <!-- Create Configuration Dialog -->
    <Dialog id="createConfigDialog"
            title="{viewModel>/dialogTitle}"
            resizable="true" draggable="true"
            contentWidth="70rem" contentHeight="45rem"
            verticalScrolling="false" horizontalScrolling="false"
            class="cfgDialog sapUiNoContentPadding sapUiResponsivePadding--content">
        <content>
            <!-- give it a hook; drop the explicit height and let flex handle it -->
            <HBox width="100%" alignItems="Stretch" class="sapUiNoContentPadding dialogBody">
                
                <!-- Left column VBox – use % height, drop top margin -->
                <VBox width="35%" height="100%" class="sapUiSmallMarginStart sapUiSmallMarginEnd">
                    <!-- Left Panel – add the class so CSS applies -->
                    <Panel headerText="{i18n>configDetails}" expandable="false" height="100%" class="fullHeightPanel">
                        <content>
                            <!-- Left inner VBox – this is the filling child (no height attr) -->
                            <VBox class="columnFill padInner">
                                <VBox>
                                    <VBox class="sapUiSmallMarginBottom">
                                        <Label text="{i18n>name}" required="true" class="sapUiTinyMarginBottom"/>
                                        <Input id="newConfigName"
                                               value="{viewModel>/newConfig/name}"
                                               placeholder="{i18n>configNamePlaceholder}" required="true" width="100%"/>
                                    </VBox>

                                    <VBox class="sapUiSmallMarginBottom">
                                        <Label text="{i18n>version}" required="true" class="sapUiTinyMarginBottom"/>
                                        <Input id="newConfigVersion"
                                               value="{viewModel>/newConfig/version}"
                                               placeholder="{i18n>versionPlaceholder}" required="true" width="100%"/>
                                    </VBox>

                                    <VBox>
                                        <Label text="{i18n>description}" class="sapUiTinyMarginBottom"/>
                                        <TextArea id="newConfigDescription"
                                                  value="{viewModel>/newConfig/description}"
                                                  rows="15" width="100%"
                                                  growing="true" growingMaxLines="20"
                                                  placeholder="{i18n>descriptionPlaceholder}"/>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </content>
                    </Panel>
                </VBox>

                <!-- Right column VBox + Panel + inner VBox -->
                <VBox width="65%" height="100%" class="sapUiSmallMarginEnd">
                    <Panel headerText="{i18n>configDataJson}" expandable="false" height="100%" class="fullHeightPanel">
                        <content>
                            <VBox class="columnFill padInner">
                                <codeeditor:CodeEditor id="newConfigEditor" type="json"
                                                       value="{viewModel>/newConfig/configData}"
                                                       width="100%"/>
                            </VBox>
                        </content>
                    </Panel>
                </VBox>

            </HBox>
        </content>
        <beginButton>
            <Button text="{i18n>create}" press="onCreateConfiguration" type="Emphasized"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press="onCancelCreateConfiguration"/>
        </endButton>
    </Dialog>

    <!-- Rollback Reason Dialog -->
    <Dialog id="rollbackReasonDialog" 
            title="{i18n>rollbackTitle}" 
            resizable="false" 
            draggable="true"
            contentWidth="30rem"
            contentHeight="auto">
        <content>
            <VBox class="sapUiMediumMargin">
                <MessageStrip 
                    text="{i18n>rollbackWarning}"
                    type="Warning"
                    class="sapUiMediumMarginBottom"/>
                <VBox>
                    <Label text="{i18n>rollbackReasonLabel}" required="true" class="sapUiTinyMarginBottom"/>
                    <TextArea id="rollbackReasonInput" 
                              value="{viewModel>/rollbackReason}" 
                              placeholder="{i18n>rollbackReasonPlaceholder}"
                              rows="3"
                              required="true"
                              width="100%"
                              liveChange="onRollbackReasonChange"/>
                </VBox>
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>rollback}" 
                    press="onConfirmRollback" 
                    type="Critical"
                    enabled="{= ${viewModel>/rollbackReason} ? ${viewModel>/rollbackReason}.trim().length > 0 : false}"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press="onCancelRollback"/>
        </endButton>
    </Dialog>

</mvc:View>