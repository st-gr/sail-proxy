{
  "_version": "1.12.0",
  "sap.app": {
    "id": "admin.modellibrary",
    "type": "application",
    "i18n": { "bundleUrl": "i18n/i18n.properties", "supportedLocales": ["", "en"], "fallbackLocale": "en" },
    "title": "Model Library",
    "description": "Models available through this gateway, their specifications, prices and entitlement catalogs",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": { "uri": "/odata/v4/admin/", "type": "OData", "settings": { "annotations": [], "odataVersion": "4.0" } }
    }
  },
  "sap.ui": { "technology": "UI5", "icons": {}, "deviceTypes": { "desktop": true, "tablet": true, "phone": true } },
  "sap.ui5": {
    "flexEnabled": false,
    "resources": { "css": [{ "uri": "css/style.css" }] },
    "rootView": { "viewName": "admin.modellibrary.view.App", "type": "XML", "id": "app" },
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.ui.core": {}, "sap.m": {}, "sap.f": {}, "sap.uxap": {}, "sap.ui.layout": {}, "sap.ui.table": {} }
    },
    "handleValidation": true,
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "admin.modellibrary.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "bypassed": { "target": ["library"] }
      },
      "routes": [
        { "name": "library", "pattern": "", "target": ["library"] },
        { "name": "detail", "pattern": "model/{modelId}", "target": ["detail"] },
        { "name": "catalogs", "pattern": "catalogs", "target": ["catalogs"] },
        { "name": "profiles", "pattern": "profiles", "target": ["catalogs"] }
      ],
      "targets": {
        "library": { "viewType": "XML", "viewName": "Library", "viewId": "library", "viewLevel": 1 },
        "detail": { "viewType": "XML", "viewName": "Detail", "viewId": "detail", "viewLevel": 2 },
        "catalogs": { "viewType": "XML", "viewName": "Catalogs", "viewId": "catalogs", "viewLevel": 1 }
      }
    },
    "models": {
      "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "admin.modellibrary.i18n.i18n", "supportedLocales": ["", "en"], "fallbackLocale": "en", "async": true } },
      "": { "dataSource": "mainService", "type": "sap.ui.model.odata.v4.ODataModel", "preload": true, "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true, "groupId": "$auto" } },
      "viewModel": { "type": "sap.ui.model.json.JSONModel" }
    }
  }
}
