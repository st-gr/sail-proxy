<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <SelectDialog id="catalogPicker" title="{i18n>addToCatalog}" noDataText="{i18n>noEditableCatalog}" multiSelect="false"
    items="{path: '/ModelCatalogs', parameters: {$filter: 'isDefault eq false'}, sorter: {path: 'name'}}" confirm=".onCatalogPicked" cancel=".onCatalogPickCancel" search=".onCatalogPickSearch">
    <StandardListItem title="{name}" description="{= ${ownerEmail} || ${i18n>ownerAdminCatalog}}" type="Active"/>
  </SelectDialog>
</core:FragmentDefinition>
