<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <!-- Name and description only: a new profile starts with every limit empty, which is "the
       platform default applies", and the limits are then edited on the detail page like a
       catalog's header. Enter creates it from either field, as in NewCatalogDialog. -->
  <Dialog id="newProfileDialog" title="{i18n>newProfile}" contentWidth="28rem" initialFocus="newProfileName">
    <f:SimpleForm layout="ResponsiveGridLayout" editable="true">
      <Label text="Name" required="true"/><Input id="newProfileName" value="{viewModel>/catalogs/newProfile/name}" submit=".onCreateProfile"/>
      <Label text="Description"/><Input id="newProfileDescription" value="{viewModel>/catalogs/newProfile/description}" submit=".onCreateProfile"/>
    </f:SimpleForm>
    <beginButton><Button text="Create" type="Emphasized" press=".onCreateProfile"/></beginButton>
    <endButton><Button text="Cancel" press=".onCancelNewProfile"/></endButton>
  </Dialog>
</core:FragmentDefinition>
