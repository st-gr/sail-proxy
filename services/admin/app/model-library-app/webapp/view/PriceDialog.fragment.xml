<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <Dialog id="priceDialog" title="{i18n>editPrice}" contentWidth="28rem">
    <f:SimpleForm layout="ResponsiveGridLayout" editable="true">
      <Label text="{i18n>priceInputLabel}" required="true"/><Input id="priceInput" value="{viewModel>/detail/priceEdit/inputCost}" type="Number"/>
      <Label text="{i18n>priceOutputLabel}" required="true"/><Input id="priceOutput" value="{viewModel>/detail/priceEdit/outputCost}" type="Number"/>
      <Label text="{i18n>priceCacheReadLabel}"/><Input id="priceCacheRead" value="{viewModel>/detail/priceEdit/cacheReadInputCost}" type="Number"/>
      <Label text="{i18n>priceCacheCreationLabel}"/><Input id="priceCacheCreation" value="{viewModel>/detail/priceEdit/cacheCreationInputCost}" type="Number"/>
      <Label text="{i18n>priceImageOutputLabel}"/><Input id="priceImageOutput" value="{viewModel>/detail/priceEdit/imageOutputCost}" type="Number"/>
      <Label text="{i18n>priceAudioInputLabel}"/><Input id="priceAudioInput" value="{viewModel>/detail/priceEdit/audioInputCost}" type="Number"/>
      <Label text="{i18n>priceAudioOutputLabel}"/><Input id="priceAudioOutput" value="{viewModel>/detail/priceEdit/audioOutputCost}" type="Number"/>
    </f:SimpleForm>
    <beginButton><Button id="priceSave" text="{i18n>save}" type="Emphasized" press=".onSavePrice"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCancelPrice"/></endButton>
  </Dialog>
</core:FragmentDefinition>
