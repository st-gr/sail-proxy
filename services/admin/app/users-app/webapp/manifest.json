{
    "_version": "1.65.0",
    "sap.app": {
        "id": "admin.users",
        "type": "application",
        "i18n": {
            "bundleUrl": "i18n/i18n.properties",
            "supportedLocales": [
                "",
                "en"
            ],
            "fallbackLocale": "en"
        },
        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "Users & Quotas",
        "description": "Administrator view of users, their constraints, usage and account status",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:lrop",
            "version": "1.18.4"
        },
        "dataSources": {
            "mainService": {
                "uri": "/odata/v4/admin/",
                "type": "OData",
                "settings": {
                    "annotations": [
                        "annotation0"
                    ],
                    "odataVersion": "4.0",
                    "withCredentials": true
                }
            },
            "annotation0": {
                "type": "ODataAnnotation",
                "uri": "annotations/annotation.xml",
                "settings": {
                    "localUri": "annotations/annotation.xml"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.136.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.fe.templates": {},
                "sap.fe.core": {},
                "sap.fe.macros": {},
                "sap.f": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleUrl": "i18n/i18n.properties",
                    "supportedLocales": [
                        "",
                        "en"
                    ],
                    "fallbackLocale": "en",
                    "async": true
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            }
        },
        "resources": {
            "css": []
        },
        "routing": {
            "config": {},
            "routes": [
                {
                    "pattern": ":?query:",
                    "name": "UsersList",
                    "target": "UsersList"
                },
                {
                    "pattern": "Users({key}):?query:",
                    "name": "UsersObjectPage",
                    "target": "UsersObjectPage"
                }
            ],
            "targets": {
                "UsersList": {
                    "type": "Component",
                    "id": "UsersList",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "contextPath": "/Users",
                            "entitySet": "Users",
                            "variantManagement": "None",
                            "initialLoad": "Enabled",
                            "controlConfiguration": {
                                "@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "enableAddCardToInsights": false,
                                        "p13nMode": [],
                                        "variantManagement": "None",
                                        "selectionMode": "Multi"
                                    }
                                }
                            },
                            "navigation": {
                                "Users": {
                                    "detail": {
                                        "route": "UsersObjectPage"
                                    }
                                }
                            }
                        }
                    }
                },
                "UsersObjectPage": {
                    "type": "Component",
                    "id": "UsersObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "contextPath": "/Users",
                            "editableHeaderContent": false,
                            "content": {
                                "header": {
                                    "actions": {
                                        "FieldHelp": {
                                            "press": "admin.users.ext.FieldHelp.onFieldHelp",
                                            "text": "Field Help",
                                            "visible": true,
                                            "enabled": true,
                                            "requiresSelection": false,
                                            "icon": "sap-icon://sys-help-2"
                                        }
                                    }
                                }
                            },
                            "controlConfiguration": {
                                "apiKeys/@com.sap.vocabularies.UI.v1.LineItem#ForUser": {
                                    "tableSettings": {
                                        "enableAddCardToInsights": false,
                                        "p13nMode": [],
                                        "personalization": false
                                    }
                                },
                                "awsCredentials/@com.sap.vocabularies.UI.v1.LineItem#ForUser": {
                                    "tableSettings": {
                                        "enableAddCardToInsights": false,
                                        "p13nMode": [],
                                        "personalization": false
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "sap.fiori": {
        "registrationIds": [],
        "archeType": "transactional"
    },
    "sap.cloud": {
        "public": true,
        "service": "admin"
    }
}
