<mvc:View
	controllerName="admin.shell.controller.Notifications"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:webc="sap.ui.webc.main"
	xmlns:webcf="sap.ui.webc.fiori">

	<webc:Popover
		id="notificationsPopover"
		class="notificationsPopover"
		placementType="Bottom"
		horizontalAlign="Center"
		allowTargetOverlap="false"
		hideArrow="false">

		<webc:header>
			<Bar class="notificationsPopoverBar">
				<contentLeft>
					<Title level="H5" text="{i18n>nav.securityEvents}" />
				</contentLeft>

				<contentRight>
					<webc:Button design="Transparent" text="{i18n>notifications.clearAll}"
						tooltip="{i18n>notifications.markAllSeen}" click="onClearAllNotifications"
						visible="{= ${notifications>/notifications}.length > 0}" />
					<webc:Button design="Transparent" icon="action-settings" tooltip="{i18n>notifications.goToSecurity}" />
				</contentRight>
			</Bar>
		</webc:header>

		<!-- Pure Web Components content - no UI5 controls -->
		<core:HTML id="wcNotificationsList" content="&lt;div&gt;&lt;/div&gt;" />

		<!-- Empty state message -->
		<VBox id="emptyStateContainer" visible="{= ${notifications>/notifications}.length === 0 &amp;&amp; !${notifications>/loading} &amp;&amp; !${notifications>/error}}" class="sapUiContentPadding">
			<VBox alignItems="Center" justifyContent="Center" height="200px">
				<core:Icon src="sap-icon://bell" size="3rem" color="#0070f2" class="sapUiMediumMarginBottom" />
				<Title text="{i18n>notifications.emptyTitle}" textAlign="Center" />
				<Text text="{i18n>notifications.emptyText}" textAlign="Center" />
			</VBox>
		</VBox>
	</webc:Popover>
</mvc:View>