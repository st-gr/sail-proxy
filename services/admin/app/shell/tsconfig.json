{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "sourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "admin/shell/*": ["./webapp/*"]
    },
    "types": ["@sapui5/types"],
    "lib": ["DOM", "ES2020"]
  },
  "include": ["webapp/**/*.ts"]
}
