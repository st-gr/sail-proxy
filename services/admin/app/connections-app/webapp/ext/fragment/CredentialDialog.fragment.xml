<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!--
		Set credential. The secret is typed into masked inputs and read once, on OK, straight from the
		control into the action call (a binding of our own, whose parameters are blanked and which is
		destroyed afterwards): it is bound to no model and never logged. Everything bound here (labels,
		visibility) is non-secret text from the "dlg" model.
	-->
	<Dialog id="dialog" title="{i18n>credential.dialogTitle}" contentWidth="28rem" draggable="false" resizable="false"
		busy="{dlg>/busy}" busyIndicatorDelay="0" afterClose=".onAfterClose">
		<VBox class="sapUiSmallMargin">
			<Text text="{dlg>/help}" class="sapUiSmallMarginBottom"/>
			<Label text="{dlg>/secretLabel}" labelFor="secret" required="true"/>
			<Input id="secret" type="Password" required="true" submit=".onOk"/>
			<Label text="{i18n>credential.sessionToken}" labelFor="sessionToken" visible="{dlg>/hasSessionToken}" class="sapUiSmallMarginTop"/>
			<Input id="sessionToken" type="Password" visible="{dlg>/hasSessionToken}" submit=".onOk"/>
		</VBox>
		<beginButton><Button text="{i18n>credential.save}" type="Emphasized" press=".onOk"/></beginButton>
		<endButton><Button text="{i18n>cancel}" press=".onCancel"/></endButton>
	</Dialog>
</core:FragmentDefinition>
