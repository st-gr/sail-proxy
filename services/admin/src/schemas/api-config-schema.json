{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sap-llm-gateway/schemas/api-config.json",
  "title": "SAP LLM Gateway API Configuration Schema",
  "description": "JSON schema for validating SAP LLM Gateway API configuration files",
  "type": "object",
  "required": [
    "api_config"
  ],
  "properties": {
    "api_config": {
      "type": "object",
      "properties": {
        "timeouts": {
          "type": "object",
          "properties": {
            "default": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000,
              "description": "Default timeout in milliseconds"
            },
            "streaming": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000,
              "description": "Streaming timeout in milliseconds"
            }
          },
          "additionalProperties": false
        },
        "logging": {
          "type": "object",
          "properties": {
            "components": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9_-]+$": {
                  "type": "string",
                  "enum": [
                    "TRACE",
                    "DEBUG",
                    "INFO",
                    "WARN",
                    "ERROR",
                    "FATAL"
                  ]
                }
              },
              "additionalProperties": false
            },
            "defaultLevel": {
              "type": "string",
              "enum": [
                "TRACE",
                "DEBUG",
                "INFO",
                "WARN",
                "ERROR",
                "FATAL"
              ],
              "description": "Default log level"
            },
            "log_folder_path": {
              "type": "string",
              "minLength": 1,
              "description": "Path to log folder"
            },
            "payload_logging_enabled": {
              "type": "boolean",
              "description": "Enable payload logging"
            }
          },
          "additionalProperties": false
        },
        "hookDefinitions": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_:=-]+$": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "header",
                    "json-path",
                    "json-path-regex",
                    "url-regex"
                  ]
                },
                "name": {
                  "type": "string",
                  "description": "Header name for header type hooks"
                },
                "path": {
                  "type": "string",
                  "description": "JSON path for json-path type hooks"
                },
                "equals": {
                  "description": "Exact match value"
                },
                "from": {
                  "type": "number",
                  "description": "Range start for header ranges"
                },
                "to": {
                  "type": "number",
                  "description": "Range end for header ranges"
                },
                "regex": {
                  "type": "string",
                  "description": "Regular expression"
                },
                "flags": {
                  "type": "string",
                  "description": "Regular expression flags"
                },
                "desc": {
                  "type": "string",
                  "description": "Hook description"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "header"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "name"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "json-path"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "json-path-regex"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path",
                      "regex"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "url-regex"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "regex"
                    ]
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "model_list_changes": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_.: -]+$": {
              "type": "object",
              "properties": {
                "hooks": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-zA-Z0-9_/-]+$": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "request"
                        ],
                        "properties": {
                          "request": {
                            "type": "object",
                            "required": [
                              "callback",
                              "match"
                            ],
                            "properties": {
                              "callback": {
                                "type": "object",
                                "required": [
                                  "id"
                                ],
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "strategy": {
                                    "type": "string",
                                    "enum": [
                                      "before",
                                      "after"
                                    ]
                                  }
                                },
                                "additionalProperties": false
                              },
                              "match": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "minItems": 1
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "subpaths_native": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_/-]+$"
                  }
                },
                "subpaths_emulated": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_/: -]+$"
                  }
                },
                "streamingSupported": {
                  "type": "boolean"
                },
                "supports_prompt_caching": {
                  "type": "boolean",
                  "description": "Optional. Resolution order: this per-model flag, then the provider-level api_config.<provider>.supports_prompt_caching flag, then a default of true for Anthropic-provider models and false for all others (see src/utils/promptCachingSupport.ts). Set false to opt a model out (e.g. claude-3-haiku). A true on an Anthropic model with no provider-level override is redundant."
                },
                "anthropic_version": {
                  "type": "string",
                  "pattern": "^(bedrock-)?\\d{4}-\\d{2}-\\d{2}$"
                },
                "pseudonymization": {
                  "$ref": "#/$defs/pseudonymizationConfig"
                },
                "unsupported_params": {
                  "description": "Request parameters this provider/model does not accept; the gateway strips them before forwarding to SAP AI Core (which otherwise returns 400 \"does not support parameters: [...]\"). A per-model list replaces the provider-level list.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "param_renames": {
                  "description": "Parameter renames applied on the direct-deployment path, e.g. {\"max_tokens\":\"max_completion_tokens\"} for OpenAI reasoning models that reject max_tokens. A per-model map replaces the provider-level map.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "supports_responses_api": {
                  "description": "Override whether this provider/model may be served on /openai/v1/responses. Absent = built-in family heuristic (deployed GPT-5+/o-series).",
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        "pseudonymization": {
          "description": "Global configuration for the pseudonymizationPlugin. These keys configure the plugin only; if the plugin is not wired into the endpoint/model hook chain, no pseudonymization occurs and the toggles have no effect.",
          "$ref": "#/$defs/pseudonymizationConfig"
        },
        "defaultHooks": {
          "description": "Per-endpoint default hooks. The optional 'pseudonymization' key force-activates and configures the pseudonymizationPlugin for that endpoint.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "pseudonymization": {
                "$ref": "#/$defs/pseudonymizationConfig"
              }
            },
            "additionalProperties": true
          }
        },
        "anthropic": {
          "$ref": "#/$defs/providerConfig"
        },
        "aws-bedrock": {
          "$ref": "#/$defs/providerConfig"
        },
        "openai": {
          "allOf": [
            {
              "$ref": "#/$defs/providerConfig"
            },
            {
              "type": "object",
              "properties": {
                "openai_deployment_api_version": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}(-preview)?$"
                }
              }
            }
          ]
        },
        "openrouter": {
          "allOf": [
            {
              "$ref": "#/$defs/providerConfig"
            },
            {
              "type": "object",
              "properties": {
                "default_pricing": {
                  "type": "object",
                  "required": [
                    "completion",
                    "image",
                    "prompt"
                  ],
                  "properties": {
                    "completion": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?$"
                    },
                    "image": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?$"
                    },
                    "prompt": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?$"
                    }
                  },
                  "additionalProperties": false
                },
                "model_mappings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "default_context_length",
                      "id_prefix",
                      "provider"
                    ],
                    "properties": {
                      "default_context_length": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "id_prefix": {
                        "type": "string",
                        "minLength": 1
                      },
                      "provider": {
                        "type": "string",
                        "minLength": 1
                      },
                      "max_tokens": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          ]
        },
        "rate_limit_handling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "default_delay_seconds": {
              "type": "number",
              "minimum": 0
            },
            "backoff_multiplier": {
              "type": "number",
              "minimum": 1
            },
            "max_delay_seconds": {
              "type": "number",
              "minimum": 0
            },
            "model_specific_delays": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9_.-]+$": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "subpath_specific_delays": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9_/-]+$": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "sap_ai_core": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "resource_group": {
              "type": "string",
              "minLength": 1
            },
            "deployment_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "perplexity": {
          "$ref": "#/$defs/providerConfig"
        },
        "web_search": {
          "type": "object",
          "properties": {
            "max_searches_per_request": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "additionalProperties": false
        },
        "hosted_tools": {
          "type": "object",
          "properties": {
            "result_cache_ttl_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400,
              "description": "Optional. How long a hosted tool's results remain replayable by a client that replays the call item. Defaults to 3600 seconds. A miss re-executes the recorded query rather than degrading the answer."
            },
            "result_cache_max_entries": {
              "type": "integer",
              "minimum": 10,
              "maximum": 10000,
              "description": "Optional. How many hosted tool results are held in the replay cache at once. Defaults to 500 entries. A miss re-executes the recorded query rather than degrading the answer."
            }
          },
          "additionalProperties": false
        },
        "namespace_tools": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "flatten",
                "strip"
              ]
            }
          },
          "additionalProperties": false
        },
        "custom_tools": {
          "type": "object",
          "description": "Codex freeform `custom` tools (apply_patch). `translate` rewrites them into function tools, which both the deployed and orchestration routes accept; `strip` removes them, leaving the model to edit files through shell commands.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "translate",
                "strip"
              ],
              "default": "translate"
            }
          },
          "additionalProperties": false
        },
        "file_search": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "embedding_model": {
              "type": "string",
              "minLength": 1
            },
            "embedding_dimensions": {
              "type": "integer",
              "minimum": 1
            },
            "rewrite_query": {
              "type": "boolean"
            },
            "rewrite_query_model": {
              "type": "string",
              "minLength": 1
            },
            "hybrid": {
              "type": "object",
              "properties": {
                "rrf_k": {
                  "type": "integer",
                  "minimum": 1
                },
                "lexical_enabled": {
                  "type": "boolean"
                },
                "candidates": {
                  "type": "integer",
                  "minimum": 1
                },
                "rerank": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "auto"
                          ]
                        }
                      ]
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "chunking": {
              "type": "object",
              "properties": {
                "max_chunk_size_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "chunk_overlap_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_file_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_tokens_per_file": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_files_per_store": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "ingestion": {
              "type": "object",
              "properties": {
                "concurrency": {
                  "type": "integer",
                  "minimum": 1
                },
                "extract_timeout_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_retries": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "blob_storage": {
              "type": "object",
              "properties": {
                "backend": {
                  "type": "string",
                  "enum": [
                    "db",
                    "local",
                    "s3"
                  ]
                },
                "local_path": {
                  "type": "string"
                },
                "s3": {
                  "type": "object",
                  "properties": {
                    "bucket": {
                      "type": "string"
                    },
                    "prefix": {
                      "type": "string"
                    },
                    "endpoint": {
                      "type": "string"
                    },
                    "region": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "teacher_logging": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "store_chunk_text": {
                  "type": "boolean"
                },
                "sample_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "max_concurrent_writes": {
                  "description": "Ceiling on in-flight teacher-label writes; excess writes are dropped, not queued. Capped at the file_search pg pool size (max: 10, see services/gateway/src/fileSearch/db.ts): above that the semaphore stops bounding anything, because the extra writes simply wait inside pg's own connection queue \u2014 turning 'dropped, not queued' into 'queued', which is the failure mode the bound exists to prevent.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              }
            },
            "tool": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "max_searches_per_request": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "max_num_results_default": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "tool_search": {
          "type": "object",
          "description": "Codex's `tool_search` deferred-tool discovery tool. `translate` rewrites it into a function tool, which both the deployed and orchestration routes accept; `strip` removes it, leaving the model unable to discover deferred tools such as MCP servers.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "translate",
                "strip"
              ],
              "default": "translate"
            },
            "hoist_discovered_tools": {
              "type": "boolean",
              "default": true,
              "description": "Lift tools discovered by tool_search into the request so the model can call them. Works around codex exposing deferred MCP tools only when the provider base_url is api.openai.com; set false once that is fixed upstream. Safe to leave on either way - names the client already declares are skipped."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pseudonymizationConfig": {
      "description": "pseudonymizationPlugin configuration. Activation ('enabled') and category toggles ('entities') apply only to this plugin; masking occurs only when the plugin runs for the request (registered in the hook chain AND an activation source fires).",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "enum": [
            "pseudonymization",
            "anonymization"
          ]
        },
        "allow_user_bypass": {
          "type": "boolean"
        },
        "entities": {
          "description": "Per-category masking toggles. true enables masking of that category, false disables it. Categories not listed keep their plugin default. Unknown category names are ignored.",
          "type": "object",
          "patternProperties": {
            "^profile-[a-z-]+$": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "providerConfig": {
      "type": "object",
      "properties": {
        "anthropic_bedrock_version": {
          "type": "string",
          "pattern": "^bedrock-\\d{4}-\\d{2}-\\d{2}$"
        },
        "excluded_beta_headers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        },
        "supported_beta_headers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        },
        "emulate_streaming_for_models": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.: -]+$"
          }
        },
        "substitute_models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "unsupported_params": {
          "description": "Request parameters this provider/model does not accept; the gateway strips them before forwarding to SAP AI Core (which otherwise returns 400 \"does not support parameters: [...]\"). A per-model list replaces the provider-level list.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "param_renames": {
          "description": "Parameter renames applied on the direct-deployment path, e.g. {\"max_tokens\":\"max_completion_tokens\"} for OpenAI reasoning models that reject max_tokens. A per-model map replaces the provider-level map.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "supports_responses_api": {
          "description": "Override whether this provider/model may be served on /openai/v1/responses. Absent = built-in family heuristic (deployed GPT-5+/o-series).",
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
