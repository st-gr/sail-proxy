{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sap-llm-gateway/schemas/api-config.json",
  "title": "SAP LLM Gateway API Configuration Schema",
  "description": "JSON schema for validating SAP LLM Gateway API configuration files",
  "type": "object",
  "required": ["api_config"],
  "properties": {
    "api_config": {
      "type": "object",
      "properties": {
        "timeouts": {
          "type": "object",
          "properties": {
            "default": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000,
              "description": "Default timeout in milliseconds"
            },
            "streaming": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000,
              "description": "Streaming timeout in milliseconds"
            }
          },
          "additionalProperties": false
        },
        "logging": {
          "type": "object",
          "properties": {
            "components": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9_-]+$": {
                  "type": "string",
                  "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"]
                }
              },
              "additionalProperties": false
            },
            "defaultLevel": {
              "type": "string",
              "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"],
              "description": "Default log level"
            },
            "log_folder_path": {
              "type": "string",
              "minLength": 1,
              "description": "Path to log folder"
            },
            "payload_logging_enabled": {
              "type": "boolean",
              "description": "Enable payload logging"
            }
          },
          "additionalProperties": false
        },
        "hookDefinitions": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_:=-]+$": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["header", "json-path", "json-path-regex", "url-regex"]
                },
                "name": {
                  "type": "string",
                  "description": "Header name for header type hooks"
                },
                "path": {
                  "type": "string",
                  "description": "JSON path for json-path type hooks"
                },
                "equals": {
                  "description": "Exact match value"
                },
                "from": {
                  "type": "number",
                  "description": "Range start for header ranges"
                },
                "to": {
                  "type": "number",
                  "description": "Range end for header ranges"
                },
                "regex": {
                  "type": "string",
                  "description": "Regular expression"
                },
                "flags": {
                  "type": "string",
                  "description": "Regular expression flags"
                },
                "desc": {
                  "type": "string",
                  "description": "Hook description"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": { "const": "header" }
                    }
                  },
                  "then": {
                    "required": ["name"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": { "const": "json-path" }
                    }
                  },
                  "then": {
                    "required": ["path"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": { "const": "json-path-regex" }
                    }
                  },
                  "then": {
                    "required": ["path", "regex"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": { "const": "url-regex" }
                    }
                  },
                  "then": {
                    "required": ["regex"]
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "model_list_changes": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_.: -]+$": {
              "type": "object",
              "properties": {
                "hooks": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-zA-Z0-9_/-]+$": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["request"],
                        "properties": {
                          "request": {
                            "type": "object",
                            "required": ["callback", "match"],
                            "properties": {
                              "callback": {
                                "type": "object",
                                "required": ["id"],
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "strategy": {
                                    "type": "string",
                                    "enum": ["before", "after"]
                                  }
                                },
                                "additionalProperties": false
                              },
                              "match": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "minItems": 1
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "subpaths_native": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_/-]+$"
                  }
                },
                "subpaths_emulated": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_/: -]+$"
                  }
                },
                "streamingSupported": {
                  "type": "boolean"
                },
                "supports_prompt_caching": {
                  "type": "boolean"
                },
                "anthropic_version": {
                  "type": "string",
                  "pattern": "^(bedrock-)?\\d{4}-\\d{2}-\\d{2}$"
                },
                "pseudonymization": {
                  "$ref": "#/$defs/pseudonymizationConfig"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        "pseudonymization": {
          "description": "Global configuration for the pseudonymizationPlugin. These keys configure the plugin only; if the plugin is not wired into the endpoint/model hook chain, no pseudonymization occurs and the toggles have no effect.",
          "$ref": "#/$defs/pseudonymizationConfig"
        },
        "defaultHooks": {
          "description": "Per-endpoint default hooks. The optional 'pseudonymization' key force-activates and configures the pseudonymizationPlugin for that endpoint.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "pseudonymization": {
                "$ref": "#/$defs/pseudonymizationConfig"
              }
            },
            "additionalProperties": true
          }
        },
        "anthropic": {
          "$ref": "#/$defs/providerConfig"
        },
        "aws-bedrock": {
          "$ref": "#/$defs/providerConfig"
        },
        "openai": {
          "allOf": [
            { "$ref": "#/$defs/providerConfig" },
            {
              "type": "object",
              "properties": {
                "openai_deployment_api_version": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}(-preview)?$"
                }
              }
            }
          ]
        },
        "openrouter": {
          "allOf": [
            { "$ref": "#/$defs/providerConfig" },
            {
              "type": "object",
              "properties": {
                "default_pricing": {
                  "type": "object",
                  "required": ["completion", "image", "prompt"],
                  "properties": {
                    "completion": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?$"
                    },
                    "image": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?$"
                    },
                    "prompt": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?$"
                    }
                  },
                  "additionalProperties": false
                },
                "model_mappings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["default_context_length", "id_prefix", "provider"],
                    "properties": {
                      "default_context_length": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "id_prefix": {
                        "type": "string",
                        "minLength": 1
                      },
                      "provider": {
                        "type": "string",
                        "minLength": 1
                      },
                      "max_tokens": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          ]
        },
        "rate_limit_handling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "default_delay_seconds": {
              "type": "number",
              "minimum": 0
            },
            "backoff_multiplier": {
              "type": "number",
              "minimum": 1
            },
            "max_delay_seconds": {
              "type": "number",
              "minimum": 0
            },
            "model_specific_delays": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9_.-]+$": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "subpath_specific_delays": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9_/-]+$": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "sap_ai_core": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "resource_group": {
              "type": "string",
              "minLength": 1
            },
            "deployment_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pseudonymizationConfig": {
      "description": "pseudonymizationPlugin configuration. Activation ('enabled') and category toggles ('entities') apply only to this plugin; masking occurs only when the plugin runs for the request (registered in the hook chain AND an activation source fires).",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "enum": ["pseudonymization", "anonymization"]
        },
        "allow_user_bypass": {
          "type": "boolean"
        },
        "entities": {
          "description": "Per-category masking toggles. true enables masking of that category, false disables it. Categories not listed keep their plugin default. Unknown category names are ignored.",
          "type": "object",
          "patternProperties": {
            "^profile-[a-z-]+$": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "providerConfig": {
      "type": "object",
      "properties": {
        "anthropic_bedrock_version": {
          "type": "string",
          "pattern": "^bedrock-\\d{4}-\\d{2}-\\d{2}$"
        },
        "excluded_beta_headers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        },
        "supported_beta_headers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        },
        "emulate_streaming_for_models": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.: -]+$"
          }
        },
        "substitute_models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  }
}