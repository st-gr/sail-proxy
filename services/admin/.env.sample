# Token-Based Validation System - Admin Service
# Generated on: 2025-07-25T19:10:00.000Z

# CAP Database Configuration using dot notation (supported in .env files)
cds.requires.db.kind=postgres
cds.requires.db.impl=@cap-js/postgres
cds.requires.db.credentials.host=postgres
cds.requires.db.credentials.port=5432
cds.requires.db.credentials.user=admin_user
cds.requires.db.credentials.password=admin_password
cds.requires.db.credentials.database=sap_llm_gateway
cds.requires.db.schema_evolution=auto
cds.sql.dialect=postgres

## SQLite configuration (development)
#cds.requires.db.kind=sqlite
#cds.requires.db.credentials.database=db/admin.db

# Gateway connection
GATEWAY_URL=http://localhost:3000

# Valkey Configuration (Optional - for distributed cache)
VALKEY_URL=redis://localhost:6379

# Security Configuration (MUST match Gateway service)
VALIDATION_TOKEN_SECRET=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
METADATA_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
AWS_SECRET_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# Development Settings
NODE_ENV=development

# Deployment Configuration
# Options: development, docker, xsuaa, btp, xsa
DEPLOY_TARGET=development

# Authentication & Authorization Configuration
# Role mapping for JWT groups to application roles (JSON format)
# Maps external identity provider groups to internal application roles
ROLE_MAPPING={"sap-llm-gateway-admin":"admin","sap-llm-gateway-user":"user"}

# OAuth2/OIDC Configuration (for Docker deployment with Dex)
# OIDC issuer URL for JWT validation (matches oauth2-proxy configuration)
OAUTH2_PROXY_OIDC_ISSUER_URL=http://dex:5556/dex

# Which identity provider shaped the incoming request. Only the value 'local'
# changes behaviour: with 'local' AND no groups on the request, roles are
# resolved from LOCAL_USER_MAPPING below instead of from ROLE_MAPPING. Any
# other value (or groups being present) takes the group-mapping path.
# Default: local
# IDENTITY_PROVIDER=local

# Email-to-role map, as JSON, used only on the local-provider path above.
# Unset, or an email that is not a key, yields the role 'user' — so a missing
# entry silently degrades an intended admin to a normal user rather than
# failing. Invalid JSON is caught and also falls back to 'user'.
# Example: {"admin@example.com":"admin","dev@example.com":"user"}
# LOCAL_USER_MAPPING=

# Public base URL of the admin service, used to build the post-logout redirect.
# Unset, it is reconstructed from the request's own protocol and Host header —
# which is wrong behind a proxy that rewrites either, sending users to an
# internal hostname after logout. Set it for any deployment that is not
# reached directly.
# Example: https://gateway.example.com
# BASE_URL=

# Where to send the browser after logout. Defaults to
# ${BASE_URL}/admin/shell/index.html, so setting BASE_URL alone is usually
# enough; set this only to leave the admin UI entirely.
# LOGOUT_REDIRECT_URL=

# Session signing secret for the DEVELOPMENT session middleware. Read ONLY when
# DEPLOY_TARGET=development — for docker, xsuaa, btp and xsa the session
# middleware is never mounted and this value is unused.
#
# Its fallback is the literal string 'dev-unsafe-secret'. That is acceptable for
# a local run and unacceptable for anything reachable by others: set it if a
# development-target instance is exposed to a network.
# DEV_SESSION_SECRET=

# Set to any non-empty value to log the decoded JWT metadata on the docker-jwt
# auth path. Debugging aid only. It prints token contents, so leave it unset
# anywhere those would be sensitive.
# DEBUG_METADATA=

# SAP AI Core region, recorded on generated AWS credentials and mapped to the
# corresponding AWS region. Default: us-east-1
# SAP_AI_REGION=us-east-1

# Database Configuration - PostgreSQL (not SQLite)
# DB_PATH=./db/admin.db  # Commented out - this forces SQLite

# Audit Configuration
AUDIT_RETENTION_DAYS=90
ENABLE_AUDIT_ENCRYPTION=true

# Security Notifications Configuration
# Minimum age in days before a notification can be deleted (default: 30)
SECURITY_NOTIFICATION_MIN_DELETE_AGE_DAYS=30
# Maximum days in the future a notification can be snoozed (default: 30)
SECURITY_NOTIFICATION_MAX_SNOOZE_DAYS=30

# Logging Configuration
# Options: ERROR, WARN, INFO, DEBUG, TRACE
LOG_LEVEL=info
PORT=4004

# Multi-Environment Authentication Notes:
# 
# LOCAL DEVELOPMENT (pnpm run dev:ts:mock):
#   - DEPLOY_TARGET=development
#   - NODE_ENV=development  
#   - Uses CAP mocked authentication from package.json
#   - Test users: admin@test.com (admin), user@test.com (user)
#
# DOCKER DEPLOYMENT (docker-compose):
#   - DEPLOY_TARGET=docker
#   - NODE_ENV=production
#   - Uses JWT authentication via oauth2-proxy + Dex
#   - Role mapping via ROLE_MAPPING environment variable
#   - Dex users: admin@example.com, user@example.com
#
# SAP BTP XSUAA DEPLOYMENT:
#   - DEPLOY_TARGET=xsuaa or btp
#   - Uses CAP native XSUAA JWT authentication
#   - Role mapping optional (XSUAA provides scopes/roles directly)
#
# HANA XSA DEPLOYMENT:
#   - DEPLOY_TARGET=xsa
#   - Uses CAP native XSA authentication
#   - Role mapping optional (XSA provides roles directly)
