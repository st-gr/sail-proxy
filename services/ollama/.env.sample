# Ollama Server Environment Configuration
# Copy this file to .env and configure your settings

# Ollama server settings
OLLAMA_PORT=11434
OLLAMA_HOST=localhost

# Main proxy configuration
MAIN_PROXY_URL=http://localhost:3000
MAIN_PROXY_API_KEY=your_api_key_here

# Alternative: Use OpenAI API key directly if main proxy requires it
# OPENAI_API_KEY=your_openai_key_here

# Debug mode (optional)
# DEBUG=true

# Timeout for non-streaming requests to the main proxy (optional, in milliseconds; default 120000)
# REQUEST_TIMEOUT=120000
