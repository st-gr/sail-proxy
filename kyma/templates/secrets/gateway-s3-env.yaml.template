# file_search S3 credentials - optional Secret template
#
# Needed only when file_search stores blobs in S3 (api_config
# file_search.blob_storage.backend "s3", blobs still in S3, or a migration to
# or from S3). The gateway Deployment references this Secret as optional, so
# the gateway starts without it.
#
# Create it directly (values never go into a tracked file):
# kubectl -n sail-proxy create secret generic gateway-s3-env \
#   --from-literal=FILE_SEARCH_S3_ACCESS_KEY_ID=<access-key-id> \
#   --from-literal=FILE_SEARCH_S3_SECRET_ACCESS_KEY=<secret-access-key>
# kubectl -n sail-proxy rollout restart deployment/gateway
#
# A later setup-kyma.js run carries its values over into the rendered
# templates/secrets/gateway-s3-env.yaml, which deploy-kyma.js applies.
#
# This file is just a reminder - do not apply it directly!
---
apiVersion: v1
kind: Secret
metadata:
  name: gateway-s3-env
  namespace: sail-proxy
type: Opaque
stringData:
  FILE_SEARCH_S3_ACCESS_KEY_ID: <access-key-id>
  FILE_SEARCH_S3_SECRET_ACCESS_KEY: <secret-access-key>
